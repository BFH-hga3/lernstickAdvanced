#!/bin/sh
# 50-disable_networkmanager_access.chroot
# Restricts the live user from modifying system-wide NetworkManager connections
# via polkit. 

PKLA_DIR=/etc/polkit-1/localauthority/50-local.d/
PKLA_FILE=${PKLA_DIR}/51-disable-networkmanager-system-access.pkla

mkdir -p ${PKLA_DIR}
cat > ${PKLA_DILE} << 'EOF'
[WLAN]
Identity=unix-user:user
Action=org.freedesktop.NetworkManager.settings.modify.system
ResultAny=no
ResultInactive=no
ResultActive=no
EOF

exit 0
