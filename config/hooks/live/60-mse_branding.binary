#!/bin/sh
# 60-mse_branding.binary
# Must run AFTER 50-grub_cleanup.binary (which removes default GRUB assets).
# mse_branding.hook.binary
#
# Runs during lb binary stage — after the squashfs is sealed but before
# the ISO is finalised. Picks up GRUB theme assets staged by
# mse_branding.hook.chroot and places them in the correct ISO binary tree
# locations where GRUB will find them at boot.
#
# Also writes the GRUB configuration snippet that activates the MSE theme,
# overriding live-build's default GRUB config.
#
# Binary hooks run with CWD = the binary tree root (the ISO filesystem).
# Paths like "boot/grub/" are relative to the ISO root here.
#
# All configurable properties are defined at the top.

exit 0

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

GRUB_TIMEOUT=10
GRUB_GFXMODE="1024x768"
MSE_BG_COLOUR="#002B5C"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

# Source: assets staged by chroot hook inside the squashfs.
# lb binary hooks run with CWD = binary/ tree, NOT the build root.
# The chroot tree is at ../chroot/ relative to binary/.
# Derive the absolute build root path to be unambiguous.
BUILD_ROOT="$(dirname "$(pwd)")"
GRUB_ASSET_SRC="${BUILD_ROOT}/chroot/usr/share/mse-branding/grub"

# Destination: ISO binary tree (relative to binary tree root)
GRUB_THEME_DEST="boot/grub/themes/mse"

# GRUB config file location in the binary tree
# live-build generates: binary/boot/grub/grub.cfg
# We append our theme config to it after live-build writes it
GRUB_CFG="boot/grub/grub.cfg"

# =============================================================================
# PART 1: Verify staged assets exist
# =============================================================================

echo "==> [1/3] Checking staged GRUB assets..."

if [ ! -d "${GRUB_ASSET_SRC}" ]; then
    echo "ERROR: GRUB asset staging dir not found: ${GRUB_ASSET_SRC}"
    echo "       Ensure mse_branding.hook.chroot ran successfully."
    exit 1
fi

for ASSET in background.png logo.png theme.txt; do
    if [ ! -f "${GRUB_ASSET_SRC}/${ASSET}" ]; then
        echo "ERROR: Missing staged asset: ${GRUB_ASSET_SRC}/${ASSET}"
        exit 1
    fi
done

echo "    All staged assets present."

# Read timeout from staged file (written by chroot hook from CONFIGURATION block)
if [ -f "${GRUB_ASSET_SRC}/timeout" ]; then
    GRUB_TIMEOUT=$(cat "${GRUB_ASSET_SRC}/timeout")
fi

echo "    GRUB timeout: ${GRUB_TIMEOUT}s"

# =============================================================================
# PART 2: Copy GRUB theme assets into the ISO binary tree
# =============================================================================

echo "==> [2/3] Installing GRUB theme into ISO binary tree..."

mkdir -p "${GRUB_THEME_DEST}"
cp "${GRUB_ASSET_SRC}/background.png" "${GRUB_THEME_DEST}/background.png"
cp "${GRUB_ASSET_SRC}/logo.png"       "${GRUB_THEME_DEST}/logo.png"
cp "${GRUB_ASSET_SRC}/theme.txt"      "${GRUB_THEME_DEST}/theme.txt"

echo "    Installed: ${GRUB_THEME_DEST}/"
ls -lh "${GRUB_THEME_DEST}/"

# =============================================================================
# PART 3: Patch GRUB config to activate MSE theme
# =============================================================================

echo "==> [3/3] Patching GRUB config to activate MSE theme..."

if [ ! -f "${GRUB_CFG}" ]; then
    echo "WARNING: ${GRUB_CFG} not found — live-build may not have generated it yet."
    echo "         Creating minimal grub.cfg with MSE theme settings."
    mkdir -p "$(dirname ${GRUB_CFG})"
    touch "${GRUB_CFG}"
fi

# Prepend MSE theme settings at the top of grub.cfg
# Prepending ensures our settings take effect before any menuentry blocks
GRUB_CFG_TMP="${GRUB_CFG}.mse-tmp"

cat > "${GRUB_CFG_TMP}" << EOF
# =============================================================================
# MSE Exam Environment — GRUB theme configuration
# Injected by: mse_branding.hook.binary
# =============================================================================
set default=0
set timeout=${GRUB_TIMEOUT}
set timeout_style=menu

# MSE theme
insmod gfxterm
insmod png
set gfxmode=${GRUB_GFXMODE}
set gfxpayload=keep
terminal_output gfxterm
set theme=/boot/grub/themes/mse/theme.txt
export theme
# =============================================================================

EOF

# Append the original live-build grub.cfg content after our header
cat "${GRUB_CFG}" >> "${GRUB_CFG_TMP}"
mv "${GRUB_CFG_TMP}" "${GRUB_CFG}"

echo "    Prepended MSE theme config to: ${GRUB_CFG}"
echo "    First 20 lines of patched grub.cfg:"
head -20 "${GRUB_CFG}" | sed 's/^/    /'

echo "==> MSE branding binary stage complete."
