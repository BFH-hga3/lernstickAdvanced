#!/bin/sh
# 80-virtualbox_guest.chroot
# Enables VirtualBox guest services if virtualbox-guest-utils is installed.
# Safe to include in production builds — exits silently if VBox is absent.
# Must run before 99-uninstall_packages which may remove vbox tools.

if dpkg -l virtualbox-guest-utils 2>/dev/null | grep -q "^ii"; then
    echo "Enabling VirtualBox guest services..."
    systemctl enable virtualbox-guest-utils.service || true
    echo "Done."
else
    echo "INFO: virtualbox-guest-utils not installed, skipping."
fi
