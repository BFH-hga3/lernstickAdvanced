#!/bin/sh
# 87-mse_autologin.chroot
#
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me>
#
# Configures GDM to automatically log in the exam user "user" with a short
# delay. Combined with 89-mse_wipe_user_home.chroot this creates the exam
# loop: login -> session -> logout -> home wipe -> auto re-login.
#
# Log prefixes: E: error, W: warning, I: info, P: progress/phase.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

# Filesystem root prefix. Production: "" (real root). Testing: e.g. /tmp/test.
#   FS_ROOT_DIR=/tmp/test ./87-mse_autologin.chroot
FS_ROOT_DIR="${FS_ROOT_DIR:-}"

LIVE_USER="user"
AUTOLOGIN_DELAY="1"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

GDM_CONF="${FS_ROOT_DIR}/etc/gdm3/daemon.conf"

# =============================================================================
# PART 1: Enable GDM timed autologin for the exam user
# =============================================================================

echo "P: 87-mse_autologin.chroot | configuring GDM autologin for '${LIVE_USER}'."

if [ ! -d "$(dirname ${GDM_CONF})" ]; then
    mkdir -p "$(dirname ${GDM_CONF})"
fi

cat > "${GDM_CONF}" << EOF
# GDM configuration -- MSE Exam Environment
# Generated by: 87-mse_autologin.chroot

[daemon]
# Timed automatic login for the exam user with a short delay.
# After logout, GDM returns to the greeter and logs the user back in
# after TimedLoginDelay seconds (auto re-login loop).
TimedLoginEnable=true
TimedLogin=${LIVE_USER}
TimedLoginDelay=${AUTOLOGIN_DELAY}

# Disable the initial-setup wizard (would block autologin on first boot)
InitialSetupEnable=false

[security]

[xdmcp]

[chooser]

[debug]
# Enable=true
EOF

if [ ! -f "${GDM_CONF}" ]; then
    echo "E: Failed to write ${GDM_CONF}"
    exit 1
fi

echo "I: Written: ${GDM_CONF}"
echo "I: TimedLogin=${LIVE_USER}, delay=${AUTOLOGIN_DELAY}s"
echo "P: 87-mse_autologin.chroot | complete."
