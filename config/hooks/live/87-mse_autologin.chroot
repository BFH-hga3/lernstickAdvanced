#!/bin/sh
# 87-mse_autologin.chroot
#
# Configures GDM to automatically log in the exam user "user".
#
# Combined with the PAM home-wipe on logout (89-mse_wipe_user_home.chroot),
# this creates the desired exam loop:
#
#   login (timed autologin, 1s) → exam session → logout
#     → PAM wipes /home/user and restores it from /etc/skel
#     → GDM auto-logs-in "user" again after 1s with a fresh home
#
# So every logout yields a clean, freshly-provisioned session with no
# manual login step. There is no login prompt at any point.
#
# Runs before 88-mse_setup_users / 89-mse_wipe so the account and wipe
# machinery it depends on are configured after — ordering is not critical
# since this only writes GDM config, but the low number keeps it early.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

LIVE_USER="user"

# GDM daemon config file
GDM_CONF="/etc/gdm3/daemon.conf"

# =============================================================================
# PART 1: Enable GDM automatic login for the exam user
# =============================================================================

echo "P: 87-mse_autologin.chroot -- Configuring GDM autologin for '${LIVE_USER}'..."

mkdir -p "$(dirname ${GDM_CONF})"

# Write the daemon config. We use TimedLogin (not AutomaticLogin) so that a
# short, explicit delay applies before login. TimedLoginDelay=1 gives a 1s
# delay at boot and after every logout — long enough for GDM to reset the
# session cleanly, short enough to feel immediate.
cat > "${GDM_CONF}" << EOF
# GDM configuration — MSE Exam Environment
# Generated by: 87-mse_autologin.chroot

[daemon]
# Timed automatic login for the exam user with a 1-second delay.
# After logout, GDM returns to the greeter and logs the user back in
# after TimedLoginDelay seconds (auto re-login loop).
TimedLoginEnable=true
TimedLogin=${LIVE_USER}
TimedLoginDelay=1

# Disable the initial-setup wizard (would block autologin on first boot)
InitialSetupEnable=false

[security]

[xdmcp]

[chooser]

[debug]
# Enable=true
EOF

echo "I:    Written: ${GDM_CONF}"
echo "I:    TimedLogin=${LIVE_USER}, delay=1s"

echo "P: 87-mse_autologin.chroot --  MSE autologin configuration complete."
