#!/bin/sh
# 88-mse_setup_users.chroot
#
# Uses live-config's own debconf/user-setup infrastructure to configure users:
#
#   - Runs a live-config hook at 0020 (before 0030-user-setup) to inject the
#     hashed password for "user" via debconf-set-selections, exactly as
#     0030-user-setup does internally with its default password.
#
#   - Runs a live-config hook at 1000 (after 0030) to create "sysadmin" and
#     set its password via usermod with the pre-hashed password.
#
#   - Disables 0040-sudo and installs a clean sudoers policy.
#
# Passwords are hashed on the BUILD HOST in functions.sh build_image() before
# lb build runs. The hashes are placed in /etc/mse/ via
# includes.chroot_before_packages and read here. This avoids the problem of
# chroot hooks not having access to host environment variables.
# Cleartext passwords never enter the chroot — only yescrypt hashes.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

LIVE_USER="user"
ADMIN_USER="sysadmin"
ADMIN_USER_GECOS="System Administrator"
ADMIN_USER_SHELL="/bin/bash"

LIVE_CONFIG_DIR="/lib/live/config"
SUDOERS_FILE="/etc/sudoers.d/mse-exam"
LIVE_CONF_DIR="/etc/live/config.conf.d"
LIVE_CONF_FILE="${LIVE_CONF_DIR}/mse-exam.conf"

# Hash files written by functions.sh on the host before lb build
HASH_DIR="/etc/mse"
LIVE_USER_HASH_FILE="${HASH_DIR}/user.hash"
ADMIN_USER_HASH_FILE="${HASH_DIR}/admin.hash"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

PRE_HOOK="${LIVE_CONFIG_DIR}/0020-mse-user-password"
POST_HOOK="${LIVE_CONFIG_DIR}/1000-mse-adduser"

# =============================================================================
# PART 1: Read pre-generated password hashes
# Hashes were generated on the host by functions.sh build_image() and placed
# in /etc/mse/ via includes.chroot_before_packages before lb build ran.
# =============================================================================

echo "==> [1/4] Reading pre-generated password hashes..."

if [ ! -f "${LIVE_USER_HASH_FILE}" ] || [ ! -f "${ADMIN_USER_HASH_FILE}" ]; then
    echo "ERROR: Password hash files not found in ${HASH_DIR}."
    echo "       Ensure MSE_USER_PASSWORD and MSE_ADMIN_PASSWORD are set in"
    echo "       constants and that functions.sh generated the hashes before"
    echo "       lb build ran. Hash files should be at:"
    echo "         config/includes.chroot_before_packages/etc/mse/user.hash"
    echo "         config/includes.chroot_before_packages/etc/mse/admin.hash"
    exit 1
fi

LIVE_USER_HASH=$(cat "${LIVE_USER_HASH_FILE}")
ADMIN_USER_HASH=$(cat "${ADMIN_USER_HASH_FILE}")

if [ -z "${LIVE_USER_HASH}" ] || [ -z "${ADMIN_USER_HASH}" ]; then
    echo "ERROR: Hash files exist but are empty. Re-run the build."
    exit 1
fi

echo "    Hash read for '${LIVE_USER}'."
echo "    Hash read for '${ADMIN_USER}'."

# =============================================================================
# PART 2: Install 0020-mse-user-password
# Runs BEFORE 0030-user-setup. Injects our hash into debconf so that
# user-setup-apply picks it up instead of the default "live" password.
# Mirrors exactly what 0030-user-setup does internally.
# =============================================================================

echo "==> [2/4] Installing pre-hook ${PRE_HOOK}..."

mkdir -p "${LIVE_CONFIG_DIR}"

# Keep user hash in file — hash contains $ chars that get shell-expanded
# if embedded directly in a heredoc script.
# The file /etc/mse/user.hash persists (from includes.chroot_before_packages)
# and is read at runtime by the boot hook.

cat > "${PRE_HOOK}" << 'BOOTEOF'
#!/bin/sh
# 0020-mse-user-password — live-config hook
# Injects the MSE exam password hash into debconf before 0030-user-setup runs.
# Hash is read from /etc/mse/user.hash — written at build time via printf
# to avoid $ expansion. debconf-set-selections receives it via a temp file.

. /usr/lib/live/config.sh

STAMP="/var/lib/live/config/0020-mse-user-password"
[ -e "${STAMP}" ] && exit 0

HASH_FILE="/etc/mse/user.hash"
if [ ! -f "${HASH_FILE}" ]; then
    echo "ERROR: User hash file not found: ${HASH_FILE}"
    exit 1
fi

# Read hash — contains $ chars, so use cat into variable
LIVE_USER_HASH=$(cat "${HASH_FILE}")

echo "MSE: injecting user password hash into debconf..."

# Write debconf selections via printf to avoid any $ interpretation
printf "user-setup passwd/user-password-crypted password %s\n" "${LIVE_USER_HASH}" \
    > /tmp/mse-passwd.cfg
printf "live-debconfig live-debconfig/passwd/user-password-crypted password %s\n" "${LIVE_USER_HASH}" \
    >> /tmp/mse-passwd.cfg

debconf-set-selections /tmp/mse-passwd.cfg
rm -f /tmp/mse-passwd.cfg

echo "MSE: password hash injected."

# Clean up hash file after use
rm -f "${HASH_FILE}"
rmdir /etc/mse 2>/dev/null || true

mkdir -p /var/lib/live/config
touch "${STAMP}"
BOOTEOF

chmod 755 "${PRE_HOOK}"

chmod 755 "${PRE_HOOK}"
echo "    Installed: ${PRE_HOOK}"

# =============================================================================
# PART 3: Install 1000-mse-adduser
# Runs AFTER 0030-user-setup. Creates sysadmin and sets its password
# directly via usermod. Also cleans up sudo artefacts from 0040-sudo.
# =============================================================================

echo "==> [3/4] Installing post-hook ${POST_HOOK}..."

# The hash contains $ characters (yescrypt: $y$j9T$...) that would be
# expanded by the shell if embedded directly in the script via heredoc.
# Write the hash to a separate file with printf (no expansion), then
# use chpasswd -e to read it — completely avoiding $ interpretation.
ADMIN_HASH_BOOT="/etc/mse/admin_boot.hash"
mkdir -p /etc/mse
printf '%s' "${ADMIN_USER_HASH}" > "${ADMIN_HASH_BOOT}"
chmod 600 "${ADMIN_HASH_BOOT}"

cat > "${POST_HOOK}" << 'BOOTEOF'
#!/bin/sh
# 1000-mse-adduser — live-config hook
# Creates sysadmin user and sets its password after live user exists.
# Password hash is read from /etc/mse/admin_boot.hash (written at build
# time via printf to avoid $ expansion). chpasswd -e writes it directly
# to /etc/shadow without shell re-interpretation.

STAMP="/var/lib/live/config/1000-mse-adduser"
[ -e "${STAMP}" ] && exit 0

ADMIN_USER="ADMIN_USER_PLACEHOLDER"
ADMIN_USER_GECOS="ADMIN_GECOS_PLACEHOLDER"
ADMIN_USER_SHELL="ADMIN_SHELL_PLACEHOLDER"
LIVE_USER="LIVE_USER_PLACEHOLDER"
ADMIN_HASH_FILE="/etc/mse/admin_boot.hash"

echo "MSE: creating sysadmin user..."

if [ ! -f "${ADMIN_HASH_FILE}" ]; then
    echo "ERROR: Admin hash file not found: ${ADMIN_HASH_FILE}"
    exit 1
fi

if ! id "${ADMIN_USER}" >/dev/null 2>&1; then
    useradd \
        --create-home \
        --shell "${ADMIN_USER_SHELL}" \
        --comment "${ADMIN_USER_GECOS}" \
        --groups sudo \
        "${ADMIN_USER}"
    echo "  Created '${ADMIN_USER}'."
else
    usermod -aG sudo "${ADMIN_USER}"
    echo "  Updated '${ADMIN_USER}'."
fi

# Use chpasswd -e to set pre-hashed password directly into /etc/shadow
# This avoids any shell expansion of $ characters in the hash
ADMIN_HASH=$(cat "${ADMIN_HASH_FILE}")
printf '%s:%s\n' "${ADMIN_USER}" "${ADMIN_HASH}" | chpasswd -e
echo "  Password set for '${ADMIN_USER}' via chpasswd -e."

# Remove live user from sudo group (exam safety)
if groups "${LIVE_USER}" 2>/dev/null | grep -q sudo; then
    gpasswd -d "${LIVE_USER}" sudo 2>/dev/null || true
    echo "  Removed '${LIVE_USER}' from sudo group."
fi

# Remove /etc/sudoers.d/live written by 0040-sudo if it slipped through
if [ -f /etc/sudoers.d/live ]; then
    rm -f /etc/sudoers.d/live
    echo "  Removed /etc/sudoers.d/live."
fi

# Clean up hash file
rm -f "${ADMIN_HASH_FILE}"
rmdir /etc/mse 2>/dev/null || true

echo "  Groups: ${LIVE_USER}=$(groups ${LIVE_USER} 2>/dev/null)"
echo "  Groups: ${ADMIN_USER}=$(groups ${ADMIN_USER} 2>/dev/null)"
echo "MSE: sysadmin setup complete."

mkdir -p /var/lib/live/config
touch "${STAMP}"
BOOTEOF

# Replace placeholder strings with actual values
sed -i "s|ADMIN_USER_PLACEHOLDER|${ADMIN_USER}|g" "${POST_HOOK}"
sed -i "s|ADMIN_GECOS_PLACEHOLDER|${ADMIN_USER_GECOS}|g" "${POST_HOOK}"
sed -i "s|ADMIN_SHELL_PLACEHOLDER|${ADMIN_USER_SHELL}|g" "${POST_HOOK}"
sed -i "s|LIVE_USER_PLACEHOLDER|${LIVE_USER}|g" "${POST_HOOK}"
chmod 755 "${POST_HOOK}"

chmod 755 "${POST_HOOK}"
echo "    Installed: ${POST_HOOK}"

# =============================================================================
# PART 4: Sudoers policy + disable 0040-sudo
# =============================================================================

echo "==> [4/4] Installing sudoers policy and disabling 0040-sudo..."

mkdir -p /etc/sudoers.d

cat > "${SUDOERS_FILE}" << EOF
# MSE Exam sudoers policy
# Generated by: 88-mse_setup_users.chroot

# sysadmin: full sudo with password
${ADMIN_USER} ALL=(ALL) PASSWD: ALL

# user: explicitly denied all sudo commands
${LIVE_USER} ALL=(ALL) !ALL
EOF

chmod 0440 "${SUDOERS_FILE}"
chown root:root "${SUDOERS_FILE}"
visudo -c -f "${SUDOERS_FILE}"
echo "    Sudoers policy validated: ${SUDOERS_FILE}"

mkdir -p "${LIVE_CONF_DIR}"

cat > "${LIVE_CONF_FILE}" << 'EOF'
# MSE Exam live-config overrides
# Disables 0040-sudo which grants live user NOPASSWD sudo access.
# Sudo policy is managed via ${SUDOERS_FILE} instead.
LIVE_CONFIG_NOCOMPONENTS="${LIVE_CONFIG_NOCOMPONENTS},sudo"
EOF

echo "    0040-sudo disabled via: ${LIVE_CONF_FILE}"

# =============================================================================
# CLEANUP: Remove hash files — must not persist in the live image
# =============================================================================

echo "==> Cleaning up build-time hash files..."
# admin.hash is no longer needed — we wrote admin_boot.hash via printf
# user.hash must NOT be removed here — it is needed at boot by
# /lib/live/config/0020-mse-user-password which runs before login.
# 0020-mse-user-password cleans it up after use.
rm -f "${ADMIN_USER_HASH_FILE}"
echo "    admin.hash removed (admin_boot.hash written for boot hook)."

echo "==> setup_users hook complete."
