#!/bin/sh
# 89-mse_wipe_user_home.chroot
#
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me>
#
# Installs a PAM session hook that wipes /home/user on logout and restores it
# from /etc/skel so the next session starts fresh. A systemd shutdown service
# is a fallback for hard shutdowns.
#
# Log prefixes: E: error, W: warning, I: info, P: progress/phase.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

# Filesystem root prefix. Production: "" (real root). Testing: e.g. /tmp/test.
FS_ROOT_DIR="${FS_ROOT_DIR:-}"

LIVE_USER="user"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

# Runtime paths (real root) — used INSIDE the generated scripts/units and PAM.
RT_HOME_DIR="/home/${LIVE_USER}"
RT_SKEL_DIR="/etc/skel"
RT_WIPE_SCRIPT="/usr/local/sbin/mse-wipe-home.sh"

# Write locations (prefixed) — where THIS hook creates files.
WIPE_SCRIPT="${FS_ROOT_DIR}${RT_WIPE_SCRIPT}"
SYSTEM_SERVICE_NAME="mse-wipe-home-shutdown"
SYSTEM_SERVICE_FILE="${FS_ROOT_DIR}/etc/systemd/system/${SYSTEM_SERVICE_NAME}.service"
PAM_DIR="${FS_ROOT_DIR}/etc/pam.d"

# =============================================================================
# PART 1: Install the wipe script
# =============================================================================

echo "P: 89-mse_wipe_user_home.chroot | installing wipe script."

if [ ! -d "$(dirname ${WIPE_SCRIPT})" ]; then
    mkdir -p "$(dirname ${WIPE_SCRIPT})"
fi

cat > "${WIPE_SCRIPT}" << EOF
#!/bin/sh
# mse-wipe-home.sh
# Wipes and restores ${RT_HOME_DIR} from ${RT_SKEL_DIR}.
# Called by PAM on session close (pam_exec) and by systemd on shutdown.
# Only wipes on close_session (never on open).

LIVE_USER="${LIVE_USER}"
HOME_DIR="${RT_HOME_DIR}"
SKEL_DIR="${RT_SKEL_DIR}"

if [ "\${PAM_TYPE}" = "open_session" ]; then
    exit 0
fi

echo "MSE home wipe: starting."

if [ -d "\${HOME_DIR}" ]; then
    rm -rf "\${HOME_DIR}"
    echo "    Wiped: \${HOME_DIR}"
fi

mkdir -p "\${HOME_DIR}"
cd "\${SKEL_DIR}" && find . | cpio -p --quiet "\${HOME_DIR}"
chown -R "\${LIVE_USER}:\${LIVE_USER}" "\${HOME_DIR}"
chmod 700 "\${HOME_DIR}"

echo "MSE home wipe: restored '\${HOME_DIR}' from '\${SKEL_DIR}'."
EOF

chmod 755 "${WIPE_SCRIPT}"
echo "I: installed: ${WIPE_SCRIPT}"

# =============================================================================
# PART 2: PAM session hook — runs at session close via pam_exec
# The PAM line references the RUNTIME script path (real root).
# =============================================================================

echo "P: 89-mse_wipe_user_home.chroot | installing PAM logout hook."

PAM_LINE="session optional pam_exec.so stdout quiet seteuid ${RT_WIPE_SCRIPT}"

for PAM_NAME in gdm-password gdm-autologin; do
    PAM_FILE="${PAM_DIR}/${PAM_NAME}"
    if [ -f "${PAM_FILE}" ]; then
        if ! grep -q "mse-wipe-home" "${PAM_FILE}"; then
            echo "${PAM_LINE}" >> "${PAM_FILE}"
            echo "I: PAM hook added to: ${PAM_FILE}"
        else
            echo "I: already present in: ${PAM_FILE}"
        fi
    else
        echo "W: ${PAM_FILE} not found -- GDM may not be installed yet."
    fi
done

# =============================================================================
# PART 3: Systemd shutdown service (fallback for hard shutdown/reboot)
# =============================================================================

echo "P: 89-mse_wipe_user_home.chroot | installing shutdown fallback service."

if [ ! -d "$(dirname ${SYSTEM_SERVICE_FILE})" ]; then
    mkdir -p "$(dirname ${SYSTEM_SERVICE_FILE})"
fi

cat > "${SYSTEM_SERVICE_FILE}" << EOF
[Unit]
Description=MSE Exam Home Wipe on Shutdown (fallback)
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=${RT_WIPE_SCRIPT}
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=halt.target reboot.target shutdown.target
EOF

echo "I: installed: ${SYSTEM_SERVICE_FILE}"

# systemctl enable only works against the real root
if [ -z "${FS_ROOT_DIR}" ]; then
    systemctl enable "${SYSTEM_SERVICE_NAME}.service"
    echo "I: service enabled: ${SYSTEM_SERVICE_NAME}.service"
else
    echo "W: FS_ROOT_DIR set -- skipping 'systemctl enable' in test mode."
fi

echo "P: 89-mse_wipe_user_home.chroot | complete."
