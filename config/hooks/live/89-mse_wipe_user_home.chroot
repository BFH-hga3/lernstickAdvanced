#!/bin/sh
# 89-mse_wipe_user_home.chroot
#
# Installs a PAM session hook that wipes /home/user on logout and restores
# it from /etc/skel so the next session starts completely fresh.
# A systemd shutdown service acts as a fallback for hard shutdowns.
#
# All configurable properties are defined at the top.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

LIVE_USER="user"
HOME_DIR="/home/${LIVE_USER}"
SKEL_DIR="/etc/skel"

WIPE_SCRIPT="/usr/local/sbin/mse-wipe-home.sh"
SYSTEM_SERVICE_NAME="mse-wipe-home-shutdown"
SYSTEM_SERVICE_FILE="/etc/systemd/system/${SYSTEM_SERVICE_NAME}.service"

# =============================================================================
# PART 1: Install the wipe script
# =============================================================================

echo "==> [1/3] Installing wipe script..."

mkdir -p "$(dirname ${WIPE_SCRIPT})"

cat > "${WIPE_SCRIPT}" << EOF
#!/bin/sh
# mse-wipe-home.sh
# Wipes and restores /home/${LIVE_USER} from /etc/skel.
# Called by PAM on session close (pam_exec) and by systemd on shutdown.
#
# IMPORTANT: When called by pam_exec on session close, PAM_TYPE=close_session.
# When called on session open, PAM_TYPE=open_session.
# We only wipe on close_session — never on open.

LIVE_USER="${LIVE_USER}"
HOME_DIR="${HOME_DIR}"
SKEL_DIR="${SKEL_DIR}"

# Only wipe on session close — pam_exec calls this on both open and close.
# PAM_TYPE is set by pam_exec: "open_session" or "close_session".
# If called from systemd shutdown PAM_TYPE is unset — treat as close.
if [ "\${PAM_TYPE}" = "open_session" ]; then
    exit 0
fi

echo "MSE home wipe: starting..."

# Wipe entire home directory
if [ -d "\${HOME_DIR}" ]; then
    rm -rf "\${HOME_DIR}"
    echo "    Wiped: \${HOME_DIR}"
fi

# Restore clean home from skel
mkdir -p "\${HOME_DIR}"
# Use find+cpio to reliably copy all skel content including hidden files
cd "\${SKEL_DIR}" && find . | cpio -p --quiet "\${HOME_DIR}"
chown -R "\${LIVE_USER}:\${LIVE_USER}" "\${HOME_DIR}"
chmod 700 "\${HOME_DIR}"

echo "MSE home wipe: restored '\${HOME_DIR}' from '\${SKEL_DIR}'."
EOF

chmod 755 "${WIPE_SCRIPT}"
echo "    Installed: ${WIPE_SCRIPT}"

# =============================================================================
# PART 2: PAM session hook — runs at session close via pam_exec
# =============================================================================
# pam_exec fires on both open_session and close_session.
# The wipe script checks PAM_TYPE=close_session so it only runs on logout.
# stdout flag ensures errors appear in the journal for debugging.
# quiet suppresses the "Calling..." pam_exec info line.

echo "==> [2/3] Installing PAM logout hook..."

PAM_LINE="session optional pam_exec.so stdout quiet seteuid ${WIPE_SCRIPT}"

for PAM_FILE in /etc/pam.d/gdm-password /etc/pam.d/gdm-autologin; do
    if [ -f "${PAM_FILE}" ]; then
        if ! grep -q "mse-wipe-home" "${PAM_FILE}"; then
            echo "${PAM_LINE}" >> "${PAM_FILE}"
            echo "    PAM hook added to: ${PAM_FILE}"
        else
            echo "    Already present in: ${PAM_FILE}"
        fi
    else
        echo "    WARNING: ${PAM_FILE} not found — GDM may not be installed yet."
    fi
done

echo "    PAM logout hook installed."

# =============================================================================
# PART 3: Systemd shutdown service (fallback for hard shutdown/reboot)
# =============================================================================

echo "==> [3/3] Installing system shutdown fallback service..."

cat > "${SYSTEM_SERVICE_FILE}" << EOF
[Unit]
Description=MSE Exam Home Wipe on Shutdown (fallback)
DefaultDependencies=no
Before=shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=${WIPE_SCRIPT}
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=halt.target reboot.target shutdown.target
EOF

systemctl enable "${SYSTEM_SERVICE_NAME}.service"

echo "    Installed: ${SYSTEM_SERVICE_FILE}"
echo "    Service enabled: ${SYSTEM_SERVICE_NAME}.service"
echo "==> Home wipe hook complete."
