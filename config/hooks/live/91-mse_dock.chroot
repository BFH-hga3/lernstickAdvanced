#!/bin/sh
# 91-mse_dock.chroot
#
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me>
#
# Configures the GNOME dock (dash) favorites for the MSE exam environment.
# Installs the dconf keyfile and locks file so students cannot modify the
# dock layout. dconf is compiled at boot via 0500-mse-dconf.
#
# Log prefixes: E: error, W: warning, I: info, P: progress/phase.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

# Filesystem root prefix. Production: "" (real root). Testing: e.g. /tmp/test.
FS_ROOT_DIR="${FS_ROOT_DIR:-}"

# Dock application list (order = left to right).
DOCK_APPS="['mse-moodle.desktop', 'mse-filedrop.desktop', 'mse-screenshot.desktop', 'org.gnome.Nautilus.desktop']"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

DCONF_DIR="${FS_ROOT_DIR}/etc/dconf/db/local.d"
DCONF_LOCKS_DIR="${DCONF_DIR}/locks"

# =============================================================================
# PART 1: Write dock dconf keyfile + locks
# =============================================================================

echo "P: 91-mse_dock.chroot | installing GNOME dock dconf config."

if [ ! -d "${DCONF_LOCKS_DIR}" ]; then
    mkdir -p "${DCONF_LOCKS_DIR}"
fi

cat > "${DCONF_DIR}/02-mse-dock" << DCONF_EOF
[org/gnome/shell]
favorite-apps=${DOCK_APPS}
DCONF_EOF

cat > "${DCONF_LOCKS_DIR}/mse-dock-locks" << 'LOCKS_EOF'
/org/gnome/shell/favorite-apps
LOCKS_EOF

echo "I: Dock config: ${DCONF_DIR}/02-mse-dock"
echo "I: Dock locks:  ${DCONF_LOCKS_DIR}/mse-dock-locks"
echo "P: 91-mse_dock.chroot | complete (dconf compiled at boot via 0500-mse-dconf)."
