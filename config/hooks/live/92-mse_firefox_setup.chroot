#!/bin/sh
# 92-mse_firefox_setup.chroot
#
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me>
#
# Configures Firefox ESR for the MSE exam environment:
#   1. System-wide enterprise policy (policies.json)
#   2. Shared Firefox profile (profiles.ini + user.js)
#   3. Two separate desktop launchers: one for Moodle, one for FileDrop
#   4. Trust-launcher autostart (dock is configured by 91-mse_dock.chroot)
#
# Design decisions:
#   - TWO launchers instead of one combined script. The combined
#     "open both URLs in one instance" approach was unreliable — the
#     second firefox invocation raced with the first instance's startup.
#     Two independent launchers each open one URL cleanly.
#   - NO bookmarks. Removed entirely — the launchers replace them.
#   - Translations disabled (browser.translations.*).
#   - Private-browsing mozilla.org info page fully suppressed.
#   - Service icons (Moodle, FileDrop) fetched from the web at build time.
#
# Requires curl + imagemagick (convert) for icon fetching — both present
# at this stage, removed later by 99-uninstall_packages.
#
# All configurable properties are defined at the top.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

# Filesystem root prefix.
# Production: empty "" → paths resolve to the real root (/usr, /etc, ...).
# Local testing: set to e.g. "/tmp/test" to write the whole tree under there
# without touching the real system. Override via environment if desired:
#   FS_ROOT_DIR=/tmp/test ./92-mse_firefox_setup.chroot
FS_ROOT_DIR="${FS_ROOT_DIR:-}"

LIVE_USER="user"
FF_PROFILE_NAME="exam.default"

# URLs
URL_MOODLE="https://moodle.msengineering.ch"
URL_FILEDROP="https://drive.switch.ch/index.php/s/NnNaOgN4lHaqe2M"

# Icon source URLs — single-file SWITCHdrive shares. The share URL returns an
# HTML page; appending /download returns the raw image file for conversion.
ICON_MOODLE_URL="https://drive.switch.ch/index.php/s/F402QruRE0k87Kt/download"
ICON_FILEDROP_URL="https://drive.switch.ch/index.php/s/wKIi9UmF6aYdkeU/download"

# Installed icon paths (hicolor icon theme, 512x512 apps)
ICON_DIR="${FS_ROOT_DIR}/usr/share/icons/hicolor/512x512/apps"
ICON_MOODLE="${ICON_DIR}/mse-moodle.png"
ICON_FILEDROP="${ICON_DIR}/mse-filedrop.png"

# System policy paths
POLICY_FILE="${FS_ROOT_DIR}/usr/lib/firefox-esr/distribution/policies.json"
POLICY_LINK_DIR="${FS_ROOT_DIR}/etc/firefox-esr/policies"

# Autoconfig — applies prefs to EVERY profile regardless of name/path.
# The .cfg lives in the firefox-esr install dir; a pref file in defaults/pref
# enables it. This is the profile-independent safety net.
FF_INSTALL_DIR="${FS_ROOT_DIR}/usr/lib/firefox-esr"
FF_AUTOCONFIG_CFG="${FF_INSTALL_DIR}/mse.cfg"
FF_AUTOCONFIG_PREF="${FF_INSTALL_DIR}/defaults/pref/autoconfig.js"

# Vendor-path symlink: make ~/.mozilla/firefox-esr resolve to the real
# ~/.mozilla/firefox profile root, so the profile is found no matter which
# vendor path firefox-esr resolves to.
FF_ESR_SKEL_LINK="${FS_ROOT_DIR}/etc/skel/.mozilla/firefox-esr"

# Desktop launchers (installed in /usr/share/applications/ for GNOME trust)
LAUNCHER_MOODLE="${FS_ROOT_DIR}/usr/share/applications/mse-moodle.desktop"
LAUNCHER_FILEDROP="${FS_ROOT_DIR}/usr/share/applications/mse-filedrop.desktop"
LAUNCHER_MOODLE_SKEL="${FS_ROOT_DIR}/etc/skel/Desktop/mse-moodle.desktop"
LAUNCHER_FILEDROP_SKEL="${FS_ROOT_DIR}/etc/skel/Desktop/mse-filedrop.desktop"

# Wrapper scripts (one per URL)
SCRIPT_DIR="${FS_ROOT_DIR}/usr/local/bin"
SCRIPT_MOODLE="${SCRIPT_DIR}/mse-moodle.sh"
SCRIPT_FILEDROP="${SCRIPT_DIR}/mse-filedrop.sh"

# Trust launcher (marks .desktop files trusted at first login)
TRUST_SCRIPT="${SCRIPT_DIR}/mse-trust-launcher.sh"
TRUST_AUTOSTART_DIR="${FS_ROOT_DIR}/etc/skel/.config/autostart"
TRUST_AUTOSTART="${TRUST_AUTOSTART_DIR}/mse-trust-launcher.desktop"

# =============================================================================
# DERIVED PATHS — computed from variables above, do not edit
# =============================================================================

FF_SKEL_DIR="${FS_ROOT_DIR}/etc/skel/.mozilla/firefox"
FF_PROFILE_DIR="${FF_SKEL_DIR}/${FF_PROFILE_NAME}"
FF_PROFILES_INI="${FF_SKEL_DIR}/profiles.ini"
FF_USER_JS="${FF_PROFILE_DIR}/user.js"

# RUNTIME paths — always real-root, NEVER prefixed with FS_ROOT_DIR.
# Used for values written INTO files (.desktop Icon=/Exec=, ln -sf targets),
# because on the booted system those paths have no test prefix.
RT_ICON_DIR="/usr/share/icons/hicolor/512x512/apps"
RT_ICON_MOODLE="${RT_ICON_DIR}/mse-moodle.png"
RT_ICON_FILEDROP="${RT_ICON_DIR}/mse-filedrop.png"
RT_SCRIPT_MOODLE="/usr/local/bin/mse-moodle.sh"
RT_SCRIPT_FILEDROP="/usr/local/bin/mse-filedrop.sh"
RT_TRUST_SCRIPT="/usr/local/bin/mse-trust-launcher.sh"
RT_LAUNCHER_MOODLE="/usr/share/applications/mse-moodle.desktop"
RT_LAUNCHER_FILEDROP="/usr/share/applications/mse-filedrop.desktop"

# =============================================================================
# PART 1: System-wide Firefox enterprise policy
# =============================================================================
echo "P: 92-mse_firefox_setup.chroot | Firefox setup start."

echo "I: Writing Firefox enterprise policy."

mkdir -p "$(dirname ${POLICY_FILE})"

cat > "${POLICY_FILE}" << 'EOF'
{
  "policies": {
    "BlockAboutConfig":            true,
    "BlockAboutProfiles":          true,
    "BlockAboutSupport":           true,
    "BlockAboutAddons":            true,
    "DisableDeveloperTools":       true,
    "DisableFirefoxAccounts":      true,
    "DisableSetDesktopBackground": true,
    "DisableTelemetry":            true,
    "DisableFirefoxStudies":       true,
    "DisablePocket":               true,
    "DisableProfileImport":        true,
    "DisableProfileRefresh":       true,
    "DisplayBookmarksToolbar":     "never",
    "DisplayMenuBar":              "never",
    "HideFirefoxAccountButton":    true,
    "NewTabPage":                  false,
    "NoDefaultBookmarks":          true,
    "OfferToSaveLogins":           false,
    "OverrideFirstRunPage":        "",
    "OverridePostUpdatePage":      "",
    "PasswordManagerEnabled":      false,
    "PromptForDownloadLocation":   false,
    "TranslateEnabled":            false,
    "WebsiteFilter": {
      "Block": ["<all_urls>"],
      "Exceptions": [
        "https://moodle.msengineering.ch/*",
        "https://drive.switch.ch/index.php/s/NnNaOgN4lHaqe2M*",
        "https://drive.switch.ch/index.php/s/tQLKBilUJ7l8DLj*"
      ]
    },
    "UserMessaging": {
      "WhatsNew":                 false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations":   false,
      "UrlbarInterventions":      false,
      "SkipOnboarding":           true,
      "MoreFromMozilla":          false
    },
    "PrivateBrowsingModeAvailability": 1,
    "FirefoxHome": {
      "Search":                   false,
      "TopSites":                 false,
      "SponsoredTopSites":        false,
      "Highlights":               false,
      "Pocket":                   false,
      "SponsoredPocket":          false,
      "Snippets":                 false,
      "Locked":                   true
    }
  }
}
EOF

echo "    Written: ${POLICY_FILE}"

mkdir -p "${POLICY_LINK_DIR}"
rm -f "${POLICY_LINK_DIR}/policies.json"
ln -s "/usr/lib/firefox-esr/distribution/policies.json" "${POLICY_LINK_DIR}/policies.json"
echo "    Symlinked: ${POLICY_LINK_DIR}/policies.json -> ${POLICY_FILE}"

# =============================================================================
# PART 2: Firefox exam profile (profiles.ini + user.js)
# =============================================================================

echo "I: Creating Firefox exam profile."

mkdir -p "${FF_PROFILE_DIR}"

cat > "${FF_PROFILES_INI}" << EOF
[Profile0]
Name=${FF_PROFILE_NAME}
IsRelative=1
Path=${FF_PROFILE_NAME}
Default=1

[General]
StartWithLastProfile=1
Version=2
EOF

echo "    profiles.ini written: ${FF_PROFILES_INI}"

cat > "${FF_USER_JS}" << 'EOF'
// -----------------------------------------------------------------------
// MSE Exam Firefox profile — user.js
// Generated by: 92-mse_firefox_setup.chroot
// -----------------------------------------------------------------------

// --- Private browsing & session ---
user_pref("browser.privatebrowsing.autostart",         true);
user_pref("browser.sessionstore.enabled",              false);
user_pref("browser.sessionstore.resume_from_crash",    false);
user_pref("privacy.sanitize.sanitizeOnShutdown",       true);
user_pref("privacy.clearOnShutdown.cookies",           true);
user_pref("privacy.clearOnShutdown.cache",             true);
user_pref("privacy.clearOnShutdown.history",           true);
user_pref("privacy.clearOnShutdown.sessions",          true);
user_pref("privacy.clearOnShutdown.formdata",          true);

// --- Password manager ---
user_pref("signon.rememberSignons",                    false);
user_pref("signon.autofillForms",                      false);

// --- Address bar ---
user_pref("browser.urlbar.suggest.history",            false);
user_pref("browser.urlbar.suggest.bookmark",           false);
user_pref("browser.urlbar.suggest.openpage",           false);
user_pref("browser.urlbar.autocomplete.enabled",       false);

// --- Bookmarks toolbar hidden (no bookmarks in this build) ---
user_pref("browser.toolbars.bookmarks.visibility",     "never");

// --- New tab & homepage ---
user_pref("browser.newtabpage.enabled",                false);
user_pref("browser.startup.homepage",                  "about:blank");
user_pref("browser.startup.page",                      0);

// --- Translations: fully disabled ---
// Prevents the translation popup/offer from appearing on foreign-language pages.
user_pref("browser.translations.enable",               false);
user_pref("browser.translations.automaticallyPopup",   false);
user_pref("browser.translations.panelShown",           true);

// --- Private browsing info page: fully suppressed ---
// Firefox tries to open https://www.mozilla.org/privacy/firefox/ and the
// private-browsing "about" page on private-window start. Both are blocked
// by the firewall and show an error tab. These prefs prevent them opening.
user_pref("browser.privatebrowsing.welcomeShown",      true);
user_pref("browser.privatebrowsing.vpnpromourl",       "");
user_pref("browser.privatebrowsing.promoEnabled",      false);
user_pref("browser.privatebrowsing.infoEnabled",       false);
user_pref("browser.privatebrowsing.felt.enabled",      false);
user_pref("privacy.trackingprotection.introCount",     20);
user_pref("privacy.trackingprotection.pbmode.enabled", false);
user_pref("extensions.pocket.enabled",                 false);

// --- Telemetry & first-run noise ---
user_pref("toolkit.telemetry.enabled",                 false);
user_pref("browser.startup.firstrunSkipsHomepage",     true);
user_pref("trailhead.firstrun.didSeeAboutWelcome",     true);
user_pref("datareporting.healthreport.uploadEnabled",  false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("app.shield.optoutstudies.enabled",          false);

// --- Suppress "know your rights" and default-browser checks ---
user_pref("browser.rights.3.shown",                    true);
user_pref("browser.shell.checkDefaultBrowser",         false);
EOF

echo "I: user.js written: ${FF_USER_JS}"

# =============================================================================
# PART 2b: Autoconfig — profile-independent prefs (belt & suspenders)
# =============================================================================
# The named profile (profiles.ini) is fragile: firefox vs firefox-esr can
# resolve a different profile root, and if profiles.ini isn't matched the
# exam profile (and its user.js) is silently ignored. Autoconfig runs for
# EVERY profile at startup, so the must-apply private-browsing prefs are
# enforced regardless of which profile Firefox actually uses.
#
# lockPref() makes a value immutable (greyed out in about:config).

echo "P: 92-mse_firefox_setup.chroot | installing Firefox autoconfig."

if [ ! -d "$(dirname ${FF_AUTOCONFIG_PREF})" ]; then
    mkdir -p "$(dirname ${FF_AUTOCONFIG_PREF})"
fi
if [ ! -d "${FF_INSTALL_DIR}" ]; then
    mkdir -p "${FF_INSTALL_DIR}"
fi

# Enabler pref file — names the .cfg and disables obfuscation/sandbox so the
# plain-text .cfg is read.
cat > "${FF_AUTOCONFIG_PREF}" << 'EOF'
// MSE exam — enable autoconfig (first line of .cfg is ignored by design)
pref("general.config.filename", "mse.cfg");
pref("general.config.obscure_value", 0);
pref("general.config.sandbox_enabled", false);
EOF

# The .cfg itself. IMPORTANT: the first line is ALWAYS ignored by Firefox's
# config parser, so it must be a comment.
cat > "${FF_AUTOCONFIG_CFG}" << 'EOF'
// MSE exam autoconfig — DO NOT REMOVE THIS FIRST COMMENT LINE
// Profile-independent enforcement of the exam private-browsing behaviour.

// --- Private browsing autostart (must always apply) ---
lockPref("browser.privatebrowsing.autostart", true);

// --- Translations fully disabled ---
lockPref("browser.translations.enable", false);
lockPref("browser.translations.automaticallyPopup", false);

// --- Suppress the mozilla.org private-browsing info/promo tab ---
lockPref("browser.privatebrowsing.welcomeShown", true);
lockPref("browser.privatebrowsing.vpnpromourl", "");
lockPref("browser.privatebrowsing.promoEnabled", false);
lockPref("browser.privatebrowsing.infoEnabled", false);
lockPref("browser.privatebrowsing.felt.enabled", false);
lockPref("privacy.trackingprotection.pbmode.enabled", false);
lockPref("extensions.pocket.enabled", false);

// --- No first-run / homepage noise ---
lockPref("browser.startup.homepage", "about:blank");
lockPref("browser.startup.page", 0);
lockPref("browser.newtabpage.enabled", false);
lockPref("browser.shell.checkDefaultBrowser", false);
EOF

echo "I: autoconfig enabler: ${FF_AUTOCONFIG_PREF}"
echo "I: autoconfig cfg:     ${FF_AUTOCONFIG_CFG}"

# =============================================================================
# PART 2c: Vendor-path symlink for firefox-esr profile resolution
# =============================================================================
# firefox-esr may look for its profile under ~/.mozilla/firefox-esr on some
# builds. Symlink that to the real ~/.mozilla/firefox so the exam profile is
# found either way. The link target is RELATIVE ("firefox") so it stays valid
# inside the user's home after skel is copied.

echo "P: 92-mse_firefox_setup.chroot | linking firefox-esr profile root."

if [ ! -d "$(dirname ${FF_ESR_SKEL_LINK})" ]; then
    mkdir -p "$(dirname ${FF_ESR_SKEL_LINK})"
fi

# Remove any stale entry, then create the relative alias.
rm -f "${FF_ESR_SKEL_LINK}"
ln -s firefox "${FF_ESR_SKEL_LINK}"

echo "I: symlink: ${FF_ESR_SKEL_LINK} -> firefox"

# =============================================================================
# PART 3: Two wrapper scripts + two desktop launchers
# =============================================================================

echo "I: Installing Moodle and FileDrop launchers."

if [ ! -d "${SCRIPT_DIR}" ]; then
    mkdir -p "${SCRIPT_DIR}"
fi

if [ ! -d "${ICON_DIR}" ]; then
    mkdir -p "${ICON_DIR}"
fi

# --- Fetch service icons from the web ---
# Downloads the favicon from each service, converts to a single PNG in a temp
# working directory, then copies the finished PNG into ICON_DIR in the fs tree.
# Falls back to firefox-esr icon name if download or conversion fails.
fetch_icon() {
    URL="$1"; OUT="$2"; NAME="$3"
    TMP="/tmp/${NAME}.download"
    WORK="/tmp/${NAME}-work.png"

    if ! curl -fsSL --connect-timeout 15 --max-time 30 "${URL}" -o "${TMP}" 2>/dev/null; then
        rm -f "${TMP}"
        echo "W:   Icon download failed for ${NAME} -- using firefox-esr."
        return 1
    fi

    # The download may be PNG, ICO (multi-frame) or SVG. For a multi-frame ICO,
    # pick the largest frame so convert emits exactly one output file.
    BEST_INDEX=0; BEST_HEIGHT=0; INDEX=0
    for H in $(identify -format '%h\n' "${TMP}" 2>/dev/null); do
        if [ "${H}" -gt "${BEST_HEIGHT}" ] 2>/dev/null; then
            BEST_HEIGHT="${H}"; BEST_INDEX="${INDEX}"
        fi
        INDEX=$((INDEX + 1))
    done

    # Convert the chosen frame to a single PNG in the temp working location.
    if ! convert "${TMP}[${BEST_INDEX}]" -resize 512x512 -background none \
        -gravity center -extent 512x512 "${WORK}" 2>/dev/null || [ ! -f "${WORK}" ]; then
        rm -f "${TMP}" "${WORK}" "/tmp/${NAME}-work-"*.png 2>/dev/null || true
        echo "W:   Icon convert failed for ${NAME} -- using firefox-esr."
        return 1
    fi

    # Copy the finished PNG into the icon theme directory in the fs tree.
    cp "${WORK}" "${OUT}"
    chmod 644 "${OUT}"
    rm -f "${TMP}" "${WORK}"

    echo "I:   Icon installed: ${OUT} (frame ${BEST_INDEX}, ${BEST_HEIGHT}px source)"
    return 0
}

# Fetch both icons; record which succeeded so launchers use the right Icon= value
if fetch_icon "${ICON_MOODLE_URL}" "${ICON_MOODLE}" "mse-moodle"; then
    ICON_MOODLE_VALUE="${RT_ICON_MOODLE}"
else
    ICON_MOODLE_VALUE="firefox-esr"
fi

if fetch_icon "${ICON_FILEDROP_URL}" "${ICON_FILEDROP}" "mse-filedrop"; then
    ICON_FILEDROP_VALUE="${RT_ICON_FILEDROP}"
else
    ICON_FILEDROP_VALUE="firefox-esr"
fi

# --- Moodle wrapper ---
cat > "${SCRIPT_MOODLE}" << EOF
#!/bin/sh
# mse-moodle.sh -- opens MSE Moodle in Firefox private mode.
exec firefox --private-window "${URL_MOODLE}"
EOF
chmod 755 "${SCRIPT_MOODLE}"
echo "    Wrapper: ${SCRIPT_MOODLE}"

# --- FileDrop wrapper ---
cat > "${SCRIPT_FILEDROP}" << EOF
#!/bin/sh
# mse-filedrop.sh -- opens MSE FileDrop in Firefox private mode.
exec firefox --private-window "${URL_FILEDROP}"
EOF
chmod 755 "${SCRIPT_FILEDROP}"
echo "    Wrapper: ${SCRIPT_FILEDROP}"

# --- Moodle launcher ---
mkdir -p "$(dirname ${LAUNCHER_MOODLE})"
cat > "${LAUNCHER_MOODLE}" << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=MSE Moodle
Comment=Open MSE Moodle in Firefox (private mode)
Exec=${RT_SCRIPT_MOODLE}
Icon=${ICON_MOODLE_VALUE}
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

chmod 755 "${LAUNCHER_MOODLE}"
echo "I:   Launcher: ${LAUNCHER_MOODLE}"

# --- FileDrop launcher ---
cat > "${LAUNCHER_FILEDROP}" << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=MSE FileDrop
Comment=Open MSE FileDrop in Firefox (private mode)
Exec=${RT_SCRIPT_FILEDROP}
Icon=${ICON_FILEDROP_VALUE}
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

chmod 755 "${LAUNCHER_FILEDROP}"
echo "I:   Launcher: ${LAUNCHER_FILEDROP}"

# --- Symlink both into skel Desktop ---
mkdir -p "$(dirname ${LAUNCHER_MOODLE_SKEL})"
ln -sf "${RT_LAUNCHER_MOODLE}"   "${LAUNCHER_MOODLE_SKEL}"
ln -sf "${RT_LAUNCHER_FILEDROP}" "${LAUNCHER_FILEDROP_SKEL}"
echo "I:   Desktop symlinks created for both launchers."

# =============================================================================
# PART 4: Trust-launcher autostart
# =============================================================================

echo "I: Installing trust launcher."
# Dock favorites are configured by 91-mse_dock.chroot.

# --- Trust-launcher script: marks both .desktop files trusted at login ---
if [ ! -d "${TRUST_AUTOSTART_DIR}" ]; then
   mkdir -p "${TRUST_AUTOSTART_DIR}"
fi

cat > "${TRUST_SCRIPT}" << 'EOF'
#!/bin/sh
# mse-trust-launcher.sh
# Marks the MSE desktop launchers as trusted so GNOME launches them
# without an "Allow Executing" dialog. Runs once at first GNOME session
# start via XDG autostart, then removes its own autostart entry.
#
# GNOME uses GVfs metadata (not filesystem xattrs) for desktop-file trust:
#   gio set FILE metadata::trusted true
#   gio set FILE unix::mode 0755

SELF_AUTOSTART="${HOME}/.config/autostart/mse-trust-launcher.desktop"

for LAUNCHER in \
    "${HOME}/Desktop/mse-moodle.desktop" \
    "${HOME}/Desktop/mse-filedrop.desktop"; do
    if [ -f "${LAUNCHER}" ]; then
        gio set "${LAUNCHER}" metadata::trusted true 2>/dev/null || true
        gio set "${LAUNCHER}" unix::mode 0755 2>/dev/null || true
        chmod +x "${LAUNCHER}" 2>/dev/null || true
    fi
done

# Remove only the autostart entry -- script stays in /usr/local/bin
rm -f "${SELF_AUTOSTART}"
EOF

chmod 755 "${TRUST_SCRIPT}"

cat > "${TRUST_AUTOSTART}" << EOF
[Desktop Entry]
Type=Application
Name=MSE Trust Launcher
Comment=Marks MSE launchers as trusted on first login
Exec=${RT_TRUST_SCRIPT}
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
NoDisplay=true
EOF

echo "    Trust script: ${TRUST_SCRIPT}"
echo "    Trust autostart: ${TRUST_AUTOSTART}"
echo "P: 92-mse_firefox_setup.chroot | Firefox setup complete."
