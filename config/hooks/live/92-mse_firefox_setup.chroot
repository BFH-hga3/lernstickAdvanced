#!/bin/sh
# 92-mse_firefox_setup.chroot
# firefox_setup.hook.chroot
#
# Consolidates all Firefox configuration for the exam environment:
#   1. Writes policies.json (system-wide enterprise policy)
#   2. Symlinks /etc/firefox-esr/policies/ -> /usr/lib/firefox-esr/distribution/
#   3. Creates a shared Firefox profile with:
#        - profiles.ini (selects exam profile by default)
#        - user.js      (privacy, session, UI preferences)
#        - bookmarks.html (two bookmarks: MSE Moodle, MSE FileDrop — imported on first run)
#   4. Creates the desktop launcher (private mode, bookmarks toolbar visible)
#
# All configurable properties are defined at the top.
# All derived paths are computed from the base variables — edit only the top block.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

LIVE_USER="user"

# Firefox profile name (used as directory name and in profiles.ini)
FF_PROFILE_NAME="exam.default"

# URLs
URL_MOODLE="https://moodle.msengineering.ch"
URL_FILEDROP="https://drive.switch.ch/index.php/s/NnNaOgN4lHaqe2M"
URL_TEMPLATE="https://drive.switch.ch/index.php/s/tQLKBilUJ7l8DLj"

# System policy paths
POLICY_FILE="/usr/lib/firefox-esr/distribution/policies.json"
POLICY_LINK_DIR="/etc/firefox-esr/policies"

# Desktop launcher — installed in /usr/share/applications/ so GNOME trusts it
# without requiring the user to right-click "Allow Launching".
LAUNCHER="/usr/share/applications/mse-exam-browser.desktop"
LAUNCHER_SKEL_LINK="/etc/skel/Desktop/mse-exam-browser.desktop"

# Wrapper script that opens both URLs in the same Firefox private window
OPEN_SCRIPT="/usr/local/bin/mse-exam-browser.sh"

# GNOME dock configuration
DCONF_DOCK_FILE="/etc/dconf/db/local.d/02-mse-dock"
DCONF_LOCKS_DIR="/etc/dconf/db/local.d/locks"

# =============================================================================
# DERIVED PATHS — computed from variables above, do not edit
# =============================================================================

FF_SKEL_DIR="/etc/skel/.mozilla/firefox"
FF_PROFILE_DIR="${FF_SKEL_DIR}/${FF_PROFILE_NAME}"
FF_PROFILES_INI="${FF_SKEL_DIR}/profiles.ini"
FF_USER_JS="${FF_PROFILE_DIR}/user.js"

# =============================================================================
# PART 1: System-wide Firefox enterprise policy
# =============================================================================

echo "==> [1/4] Writing Firefox enterprise policy..."

mkdir -p "$(dirname ${POLICY_FILE})"

cat > "${POLICY_FILE}" << 'EOF'
{
  "policies": {
    "BlockAboutConfig":            true,
    "BlockAboutProfiles":          true,
    "BlockAboutSupport":           true,
    "BlockAboutAddons":            true,
    "DisableDeveloperTools":       true,
    "DisableFirefoxAccounts":      true,
    "DisableSetDesktopBackground": true,
    "DisableTelemetry":            true,
    "DisplayBookmarksToolbar":     "always",
    "DisplayMenuBar":              "never",
    "HideFirefoxAccountButton":    true,
    "NewTabPage":                  false,
    "NoDefaultBookmarks":          true,
    "OverrideFirstRunPage":        "",
    "OverridePostUpdatePage":      "",
    "PasswordManagerEnabled":      false,
    "WebsiteFilter": {
      "Block": ["<all_urls>"],
      "Exceptions": [
        "https://moodle.msengineering.ch/*",
        "https://drive.switch.ch/index.php/s/NnNaOgN4lHaqe2M*",
        "https://drive.switch.ch/index.php/s/tQLKBilUJ7l8DLj*"
      ]
    },
    "UserMessaging": {
      "WhatsNew":                 false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations":   false,
      "UrlbarInterventions":      false,
      "SkipOnboarding":           true
    }
  }
}
EOF

echo "    Written: ${POLICY_FILE}"

# Symlink /etc/firefox-esr/policies/policies.json -> POLICY_FILE
# firefox-esr creates /etc/firefox-esr/ as a directory; placing files there
# via includes.chroot_after_packages causes a conflict. Hook-time symlink
# avoids the issue.
mkdir -p "${POLICY_LINK_DIR}"
rm -f "${POLICY_LINK_DIR}/policies.json"
ln -s "${POLICY_FILE}" "${POLICY_LINK_DIR}/policies.json"
echo "    Symlinked: ${POLICY_LINK_DIR}/policies.json -> ${POLICY_FILE}"

# =============================================================================
# PART 2: Firefox exam profile
# =============================================================================

echo "==> [2/4] Creating Firefox exam profile..."

mkdir -p "${FF_PROFILE_DIR}"

# profiles.ini — tells Firefox to load FF_PROFILE_NAME by default
cat > "${FF_PROFILES_INI}" << EOF
[Profile0]
Name=${FF_PROFILE_NAME}
IsRelative=1
Path=${FF_PROFILE_NAME}
Default=1

[General]
StartWithLastProfile=1
Version=2
EOF

echo "    profiles.ini written: ${FF_PROFILES_INI}"

# user.js — privacy, session and UI preferences
cat > "${FF_USER_JS}" << EOF
// -----------------------------------------------------------------------
// MSE Exam Firefox profile — user.js
// Generated by: firefox_setup.hook.chroot
// Overrides prefs set by policies.json at the preference level.
// -----------------------------------------------------------------------

// --- Private browsing & session ---
user_pref("browser.privatebrowsing.autostart",        true);
user_pref("browser.sessionstore.enabled",             false);
user_pref("browser.sessionstore.resume_from_crash",   false);
user_pref("privacy.sanitize.sanitizeOnShutdown",      true);
user_pref("privacy.clearOnShutdown.cookies",          true);
user_pref("privacy.clearOnShutdown.cache",            true);
user_pref("privacy.clearOnShutdown.history",          true);
user_pref("privacy.clearOnShutdown.sessions",         true);
user_pref("privacy.clearOnShutdown.formdata",         true);

// --- Password manager ---
user_pref("signon.rememberSignons",   false);
user_pref("signon.autofillForms",     false);

// --- Address bar ---
user_pref("browser.urlbar.suggest.history",           false);
user_pref("browser.urlbar.suggest.bookmark",          true);
user_pref("browser.urlbar.suggest.openpage",          false);
user_pref("browser.urlbar.autocomplete.enabled",      false);

// --- Bookmarks toolbar (belt-and-suspenders alongside policy) ---
user_pref("browser.toolbars.bookmarks.visibility",    "always");

// --- New tab & homepage ---
user_pref("browser.newtabpage.enabled",               false);
user_pref("browser.startup.homepage",                 "about:blank");

// --- Telemetry & first-run noise ---
user_pref("toolkit.telemetry.enabled",                false);
user_pref("browser.startup.firstrunSkipsHomepage",    true);
user_pref("trailhead.firstrun.didSeeAboutWelcome",    true);
user_pref("datareporting.healthreport.uploadEnabled", false);
user_pref("app.shield.optoutstudies.enabled",         false);
EOF

echo "    user.js written: ${FF_USER_JS}"

# =============================================================================
# PART 3: Bookmarks via bookmarks.html + user.js import
# =============================================================================
# The places.sqlite approach is fragile — the schema changes between Firefox
# versions and Firefox silently rebuilds an unrecognised database, losing all
# bookmarks. The reliable cross-version approach is:
#   1. Decode a Netscape Bookmark File (bookmarks.html) into the profile
#   2. Set user.js prefs to import it on first run and show the toolbar
# Firefox has supported this import mechanism since version 1.0.

echo "==> [3/4] Installing bookmarks (bookmarks.html + user.js import)..."

# Netscape Bookmark File with MSE Moodle and MSE FileDrop on the toolbar.
# base64-encoded to keep the hook self-contained.
BOOKMARKS_B64=""

BOOKMARKS_FILE="${FF_PROFILE_DIR}/bookmarks.html"

echo "${BOOKMARKS_B64}" | tr -d ' \n' | base64 -d > "${BOOKMARKS_FILE}"
echo "    bookmarks.html written: ${BOOKMARKS_FILE}"

# Append bookmark import prefs to user.js
# - browser.bookmarks.file: path to the bookmarks.html to import
# - browser.places.importBookmarksHTML: trigger import on next start
# - browser.bookmarks.restore_default_bookmarks: false prevents overwrite
cat >> "${FF_USER_JS}" << EOF

// --- Bookmark import (written by firefox_setup.hook.chroot PART 3) ---
// Import bookmarks.html on first run, then clear the flag.
user_pref("browser.bookmarks.file",                    "${BOOKMARKS_FILE}");
user_pref("browser.places.importBookmarksHTML",        true);
user_pref("browser.bookmarks.restore_default_bookmarks", false);
EOF

echo "    Bookmark import prefs appended to: ${FF_USER_JS}"

# Firefox will create places.sqlite fresh on first run
# and populate it from bookmarks.html via the import pref above.
rm -f "${FF_PROFILE_DIR}/places.sqlite"
# The following heredoc close token from the old approach is gone.
# Jump directly to PART 4.
true
echo "    Bookmarks configured via HTML import."

# =============================================================================
# PART 3b (padding — keeping part numbers consistent)
# =============================================================================
# =============================================================================
# PART 4: Desktop launcher
# =============================================================================

echo "==> [4/4] Installing desktop launcher, wrapper script and dock config..."

# --- Wrapper script: opens both URLs in one Firefox private-window session ---
# Firefox --private-window only accepts one URL directly. To open both Moodle
# and FileDrop we start Firefox with the first URL, wait for it to be ready,
# then open the second URL in the same instance via a second invocation
# (Firefox passes the URL to the running instance when already open).

mkdir -p "$(dirname ${OPEN_SCRIPT})"

cat > "${OPEN_SCRIPT}" << EOF
#!/bin/sh
# mse-exam-browser.sh
# Opens MSE Moodle and MSE FileDrop in Firefox private mode.
# Installed by: firefox_setup.hook.chroot

URL_MOODLE="${URL_MOODLE}"
URL_FILEDROP="${URL_FILEDROP}"

# Open first URL in a new private window
firefox --private-window "\${URL_MOODLE}" &

# Wait for Firefox to initialise, then open second URL in the same instance.
# Firefox detects the running instance and opens it as a new tab/window.
sleep 3
firefox --private-window "\${URL_FILEDROP}"
EOF

chmod +x "${OPEN_SCRIPT}"
echo "    Wrapper script installed: ${OPEN_SCRIPT}"

# --- Desktop launcher in /usr/share/applications/ ---
# Installing here makes GNOME trust the launcher automatically.
# Files on the Desktop that point outside /usr/share/applications/ require
# the user to right-click "Allow Launching" — this avoids that entirely.

mkdir -p "$(dirname ${LAUNCHER})"

cat > "${LAUNCHER}" << EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=MSE Exam Browser
Comment=Opens Moodle and FileDrop in Firefox private mode
Exec=${OPEN_SCRIPT}
Icon=firefox-esr
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

chmod +x ${LAUNCHER}

echo "    Launcher installed: ${LAUNCHER}"

# --- Symlink into skel Desktop so it appears for the live user ---
# Symlink to /usr/share/applications/ entry → GNOME trusts it automatically.
mkdir -p "$(dirname ${LAUNCHER_SKEL_LINK})"
ln -sf "${LAUNCHER}" "${LAUNCHER_SKEL_LINK}"
echo "    Desktop symlink: ${LAUNCHER_SKEL_LINK} -> ${LAUNCHER}"

# --- GNOME dock: replace Firefox with our MSE launcher ---
# Sets dash-to-dock favorites via dconf system defaults.
# Removes org.gnome.Nautilus, org.gnome.Calendar etc. — keep only what
# is needed in the exam environment.

mkdir -p "${DCONF_LOCKS_DIR}"

cat > "${DCONF_DOCK_FILE}" << EOF
[org/gnome/shell]
favorite-apps=['mse-exam-browser.desktop', 'org.gnome.Nautilus.desktop']
EOF

cat >> "${DCONF_LOCKS_DIR}/mse-wallpaper-locks" << EOF
/org/gnome/shell/favorite-apps
EOF

# Recompile dconf database
# dconf update is deferred to boot via live-config hook 0500-mse-dconf
# (installed by 93-mse_branding.chroot). Calling dconf update here would
# be overridden by live-config at first boot anyway.
echo "    GNOME dock configured: ${DCONF_DOCK_FILE}"
echo "==> Firefox setup complete."
