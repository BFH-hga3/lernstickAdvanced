#!/bin/sh
# 93-mse_branding.chroot
# Must run before 99-uninstall_packages (uses imagemagick, librsvg2-bin, curl).
# mse_branding.hook.chroot
#
# Runs during lb chroot stage. Generates all MSE branding assets:
#   1. Downloads MSE logo from msengineering.ch (fallback: ImageMagick text)
#   2. Generates GNOME wallpaper (1920x1080, navy + logo)
#   3. Generates GRUB theme assets (background.png, logo.png, theme.txt)
#      → assets are staged to GRUB_ASSET_DIR for pickup by binary hook
#   4. Installs dconf wallpaper config files (compiled at boot via live-config)
#   5. Installs live-config boot hook to compile dconf database at first boot
#
# GRUB assets are NOT placed in /boot/grub/ here — that is handled by
# mse_branding.hook.binary which runs during lb binary and writes directly
# into the ISO binary tree where GRUB expects them.
#
# All configurable properties are defined at the top.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

MSE_BG_COLOUR="#002B5C"
MSE_ACCENT_COLOUR="#FFFFFF"

LOGO_SVG_URL="https://www.msengineering.ch/_assets/0a6b389c64780974c6ce7ea1cdfa38d4/Images/Logo/mse-full-white.svg"
LOGO_DARK_URL="https://www.msengineering.ch/_assets/0a6b389c64780974c6ce7ea1cdfa38d4/Images/Logo/mse-full.svg"

WALLPAPER_WIDTH=1920
WALLPAPER_HEIGHT=1080

GRUB_TIMEOUT=10

LIVE_CONFIG_DIR="/lib/live/config"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

WALLPAPER_DIR="/usr/share/backgrounds/mse"
WALLPAPER_FILE="${WALLPAPER_DIR}/mse-wallpaper.png"

# GRUB assets staged here — picked up by mse_branding.hook.binary
GRUB_ASSET_DIR="/usr/share/mse-branding/grub"
GRUB_BG_FILE="${GRUB_ASSET_DIR}/background.png"
GRUB_LOGO_FILE="${GRUB_ASSET_DIR}/logo.png"
GRUB_THEME_FILE="${GRUB_ASSET_DIR}/theme.txt"
GRUB_TIMEOUT_FILE="${GRUB_ASSET_DIR}/timeout"

DCONF_DIR="/etc/dconf/db/local.d"
DCONF_LOCKS_DIR="${DCONF_DIR}/locks"
DCONF_HOOK="${LIVE_CONFIG_DIR}/0500-mse-dconf"

WORK_DIR="/tmp/mse-branding"
LOGO_PNG="${WORK_DIR}/mse-logo-white.png"
LOGO_SVG="${WORK_DIR}/mse-logo-white.svg"

# =============================================================================
# HELPERS
# =============================================================================

require_tool() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "ERROR: required tool '$1' not found."
        echo "       Add the package providing '$1' to your package lists."
        exit 1
    fi
}

download_asset() {
    URL="$1"; DEST="$2"
    echo "    Downloading: ${URL}"
    curl -fsSL --connect-timeout 15 --max-time 30 "${URL}" -o "${DEST}" 2>/dev/null
}

# =============================================================================
# PART 0: Verify tools and prepare workspace
# =============================================================================

echo "==> [0/5] Checking tools..."
require_tool curl
require_tool convert       # imagemagick
require_tool rsvg-convert  # librsvg2-bin

mkdir -p \
    "${WORK_DIR}" \
    "${WALLPAPER_DIR}" \
    "${GRUB_ASSET_DIR}" \
    "${DCONF_DIR}" \
    "${DCONF_LOCKS_DIR}"

# =============================================================================
# PART 1: Download MSE logo
# =============================================================================

echo "==> [1/5] Downloading MSE logo..."

LOGO_OK=0
if download_asset "${LOGO_SVG_URL}" "${LOGO_SVG}"; then
    if rsvg-convert -w 600 -h 200 "${LOGO_SVG}" -o "${LOGO_PNG}" 2>/dev/null; then
        LOGO_OK=1
        echo "    Logo downloaded and converted."
    fi
fi

if [ "${LOGO_OK}" -eq 0 ]; then
    echo "    WARNING: Download failed — generating fallback logo with ImageMagick."
    convert -size 600x200 xc:"${MSE_BG_COLOUR}" \
        -fill "${MSE_ACCENT_COLOUR}" \
        -font DejaVu-Sans-Bold \
        -pointsize 72 \
        -gravity Center \
        -annotate 0 "MSE" \
        "${LOGO_PNG}"
fi

# =============================================================================
# PART 2: Generate GNOME wallpaper
# =============================================================================

echo "==> [2/5] Generating GNOME wallpaper (${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT})..."

convert \
    -size "${WALLPAPER_WIDTH}x${WALLPAPER_HEIGHT}" \
    xc:"${MSE_BG_COLOUR}" \
    \( "${LOGO_PNG}" -resize 500x167 \) \
    -gravity Center \
    -composite \
    -fill "${MSE_ACCENT_COLOUR}" \
    -font DejaVu-Sans \
    -pointsize 24 \
    -gravity South \
    -annotate +0+60 "Master of Science in Engineering — Exam Environment" \
    "${WALLPAPER_FILE}"

echo "    Wallpaper: ${WALLPAPER_FILE}"

# =============================================================================
# PART 3: Generate GRUB theme assets (staged for binary hook)
# =============================================================================

echo "==> [3/5] Generating GRUB theme assets → ${GRUB_ASSET_DIR}..."

# Background (1024x768 — standard GRUB gfxmode resolution)
convert \
    -size 1024x768 \
    xc:"${MSE_BG_COLOUR}" \
    \( "${LOGO_PNG}" -resize 400x133 \) \
    -gravity North \
    -geometry +0+80 \
    -composite \
    "${GRUB_BG_FILE}"

# Logo for theme.txt
convert "${LOGO_PNG}" -resize 300x100 "${GRUB_LOGO_FILE}"

# theme.txt
cat > "${GRUB_THEME_FILE}" << 'EOF'
# MSE GRUB Theme — msengineering.ch
title-text: ""
desktop-image: "background.png"
desktop-color: "#002B5C"

+ boot_menu {
    left   = 15%
    top    = 45%
    width  = 70%
    height = 40%
    item_font            = "DejaVu Sans Regular 16"
    item_color           = "#FFFFFF"
    selected_item_color  = "#002B5C"
    icon_width           = 32
    icon_height          = 32
    item_height          = 40
    item_padding         = 8
    item_spacing         = 4
    scrollbar            = true
    scrollbar_width      = 8
}

+ image {
    top    = 6%
    left   = 50%-150
    width  = 300
    height = 100
    file   = "logo.png"
}

+ label {
    top   = 88%
    left  = 0
    width = 100%
    align = "center"
    font  = "DejaVu Sans Regular 14"
    color = "#AAAAAA"
    text  = "Booting in %d seconds..."
}
EOF

# Store timeout value for binary hook to embed in GRUB config
echo "${GRUB_TIMEOUT}" > "${GRUB_TIMEOUT_FILE}"

echo "    GRUB assets staged: ${GRUB_ASSET_DIR}"
echo "    Binary hook (mse_branding.hook.binary) will place them in the ISO."

# =============================================================================
# PART 4: Install dconf wallpaper config (files only — NOT compiled here)
# =============================================================================

echo "==> [4/5] Installing dconf wallpaper config files..."

# Write dconf keyfile — but do NOT run dconf update here.
# live-config resets the dconf database at boot, so we compile it there
# via the live-config hook installed in PART 5.

cat > "${DCONF_DIR}/01-mse-wallpaper" << EOF
[org/gnome/desktop/background]
picture-uri='file://${WALLPAPER_FILE}'
picture-uri-dark='file://${WALLPAPER_FILE}'
picture-options='zoom'
primary-color='${MSE_BG_COLOUR}'
secondary-color='${MSE_BG_COLOUR}'

[org/gnome/desktop/screensaver]
picture-uri='file://${WALLPAPER_FILE}'
primary-color='${MSE_BG_COLOUR}'
EOF

cat > "${DCONF_LOCKS_DIR}/mse-wallpaper-locks" << 'EOF'
/org/gnome/desktop/background/picture-uri
/org/gnome/desktop/background/picture-uri-dark
/org/gnome/desktop/background/picture-options
/org/gnome/desktop/screensaver/picture-uri
/org/gnome/shell/favorite-apps
EOF

echo "    dconf config files written (compilation deferred to boot)."

# =============================================================================
# PART 5: Install live-config boot hook to compile dconf at first boot
# =============================================================================

echo "==> [5/5] Installing live-config dconf boot hook..."

mkdir -p "${LIVE_CONFIG_DIR}"

cat > "${DCONF_HOOK}" << 'EOF'
#!/bin/sh
# 0500-mse-dconf — live-config hook
# Compiles the MSE dconf database at boot, after live-config has run its
# own dconf/GSettings setup. This ensures our wallpaper and dock settings
# are not overwritten by live-config's own initialisation.
#
# Installed by: mse_branding.hook.chroot

STAMP="/var/lib/live/config/0500-mse-dconf"
[ -e "${STAMP}" ] && exit 0

echo "MSE: compiling dconf database..."

# Recompile all dconf databases including our local.d entries
dconf update

echo "MSE: dconf compiled."

mkdir -p /var/lib/live/config
touch "${STAMP}"
EOF

chmod 755 "${DCONF_HOOK}"
echo "    live-config hook installed: ${DCONF_HOOK}"

# =============================================================================
# CLEANUP
# =============================================================================

rm -rf "${WORK_DIR}"
echo "==> MSE branding chroot stage complete."
echo "    GRUB assets in ${GRUB_ASSET_DIR} will be placed in the ISO by"
echo "    mse_branding.hook.binary during lb binary stage."
