#!/bin/sh
# 94-mse_bootlogo.chroot
#
# Generates MSE GRUB bootloader theme assets during the chroot stage.
# Assets are staged to /usr/share/mse-branding/grub/ for pickup by
# 60-mse_branding.binary which runs during lb binary and copies them
# into the ISO binary tree where GRUB expects them.
#
# Requires the MSE logo PNG generated by 93-mse_wallpaper.chroot.
# Must run AFTER 93-mse_wallpaper and BEFORE 99-uninstall_packages
# (uses imagemagick).

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

MSE_BG_COLOUR="#002B5C"
GRUB_TIMEOUT=10

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

# Logo generated by 93-mse_wallpaper.chroot — reuse it
# If this hook runs independently (e.g. 93 disabled), re-download
WALLPAPER_DIR="/usr/share/backgrounds/mse"
LOGO_CACHE="/usr/share/mse-branding/mse-logo-white.png"

GRUB_ASSET_DIR="/usr/share/mse-branding/grub"
GRUB_BG_FILE="${GRUB_ASSET_DIR}/background.png"
GRUB_LOGO_FILE="${GRUB_ASSET_DIR}/logo.png"
GRUB_THEME_FILE="${GRUB_ASSET_DIR}/theme.txt"
GRUB_TIMEOUT_FILE="${GRUB_ASSET_DIR}/timeout"

LOGO_SVG_URL="https://www.msengineering.ch/_assets/0a6b389c64780974c6ce7ea1cdfa38d4/Images/Logo/mse-full-white.svg"
WORK_DIR="/tmp/mse-bootlogo"

# =============================================================================
# HELPERS
# =============================================================================

require_tool() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "ERROR: required tool '$1' not found. Add it to your package lists."
        exit 1
    fi
}

# =============================================================================
# PART 0: Verify tools and prepare workspace
# =============================================================================

echo "==> [0/3] Checking tools..."
require_tool convert   # imagemagick

mkdir -p "${WORK_DIR}" "${GRUB_ASSET_DIR}" "/usr/share/mse-branding"

# =============================================================================
# PART 1: Get the MSE logo PNG
# Reuse the cached version from 93-mse_wallpaper if available,
# otherwise download and convert fresh.
# =============================================================================

echo "==> [1/3] Getting MSE logo for GRUB theme..."

LOGO_PNG="${WORK_DIR}/mse-logo-white.png"

if [ -f "${LOGO_CACHE}" ]; then
    cp "${LOGO_CACHE}" "${LOGO_PNG}"
    echo "    Reused cached logo from 93-mse_wallpaper."
elif command -v curl >/dev/null 2>&1 && command -v rsvg-convert >/dev/null 2>&1; then
    LOGO_SVG="${WORK_DIR}/mse-logo-white.svg"
    if curl -fsSL --connect-timeout 15 --max-time 30 \
        "${LOGO_SVG_URL}" -o "${LOGO_SVG}" 2>/dev/null; then
        rsvg-convert -w 600 -h 200 "${LOGO_SVG}" -o "${LOGO_PNG}" 2>/dev/null
        echo "    Logo downloaded and converted."
    fi
fi

# Fallback: generate text-based logo
if [ ! -f "${LOGO_PNG}" ]; then
    echo "    WARNING: Logo unavailable — generating ImageMagick fallback."
    convert -size 600x200 xc:"${MSE_BG_COLOUR}" \
        -fill "#FFFFFF" -font DejaVu-Sans-Bold \
        -pointsize 72 -gravity Center -annotate 0 "MSE" \
        "${LOGO_PNG}"
fi

# Cache logo for potential reuse
cp "${LOGO_PNG}" "${LOGO_CACHE}"

# =============================================================================
# PART 2: Generate GRUB theme assets
# =============================================================================

echo "==> [2/3] Generating GRUB theme assets → ${GRUB_ASSET_DIR}..."

# Background: 1024x768 (standard GRUB gfxmode resolution)
convert \
    -size 1024x768 \
    xc:"${MSE_BG_COLOUR}" \
    \( "${LOGO_PNG}" -resize 400x133 \) \
    -gravity North \
    -geometry +0+80 \
    -composite \
    "${GRUB_BG_FILE}"

# Logo for theme.txt reference
convert "${LOGO_PNG}" -resize 300x100 "${GRUB_LOGO_FILE}"

echo "    background.png: ${GRUB_BG_FILE}"
echo "    logo.png:       ${GRUB_LOGO_FILE}"

# =============================================================================
# PART 3: Write GRUB theme.txt and timeout
# =============================================================================

echo "==> [3/3] Writing GRUB theme.txt..."

cat > "${GRUB_THEME_FILE}" << 'EOF'
# MSE GRUB Theme — msengineering.ch
title-text: ""
desktop-image: "background.png"
desktop-color: "#002B5C"

+ boot_menu {
    left   = 15%
    top    = 45%
    width  = 70%
    height = 40%
    item_font            = "DejaVu Sans Regular 16"
    item_color           = "#FFFFFF"
    selected_item_color  = "#002B5C"
    icon_width           = 32
    icon_height          = 32
    item_height          = 40
    item_padding         = 8
    item_spacing         = 4
    scrollbar            = true
    scrollbar_width      = 8
}

+ image {
    top    = 6%
    left   = 50%-150
    width  = 300
    height = 100
    file   = "logo.png"
}

+ label {
    top   = 88%
    left  = 0
    width = 100%
    align = "center"
    font  = "DejaVu Sans Regular 14"
    color = "#AAAAAA"
    text  = "Booting in %d seconds..."
}
EOF

# Store timeout for binary hook to embed in grub.cfg
echo "${GRUB_TIMEOUT}" > "${GRUB_TIMEOUT_FILE}"
echo "    theme.txt: ${GRUB_THEME_FILE}"
echo "    timeout:   ${GRUB_TIMEOUT}s"

# =============================================================================
# CLEANUP
# =============================================================================

rm -rf "${WORK_DIR}"
echo "==> MSE bootlogo assets complete."
echo "    Staged in ${GRUB_ASSET_DIR} — picked up by 60-mse_branding.binary."
