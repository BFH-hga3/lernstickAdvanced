#!/bin/sh
# 98-mse_dconf_compile.chroot
#
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me>
#
# Ensures the dconf profile loads the local database and installs the shared
# live-config boot hook 0500-mse-dconf which compiles the dconf database at
# first boot, after live-config has completed its own GNOME initialisation.
#
# Log prefixes: E: error, W: warning, I: info, P: progress/phase.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

# Filesystem root prefix. Production: "" (real root). Testing: e.g. /tmp/test.
FS_ROOT_DIR="${FS_ROOT_DIR:-}"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

LIVE_CONFIG_DIR="${FS_ROOT_DIR}/lib/live/config"
DCONF_HOOK="${LIVE_CONFIG_DIR}/0500-mse-dconf"
DCONF_PROFILE_DIR="${FS_ROOT_DIR}/etc/dconf/profile"
DCONF_PROFILE="${DCONF_PROFILE_DIR}/user"

# =============================================================================
# PART 1: Ensure the dconf profile loads the local database
# =============================================================================
# Without /etc/dconf/profile/user listing "system-db:local", the local
# database (where 01-mse-wallpaper, 02-mse-dock, 03-mse-keyboard live) is
# never consulted, and our settings + locks have no effect.

echo "P: 98-mse_dconf_compile.chroot | ensuring dconf profile loads local database."

if [ ! -d "${DCONF_PROFILE_DIR}" ]; then
    mkdir -p "${DCONF_PROFILE_DIR}"
fi

cat > "${DCONF_PROFILE}" << 'PROFILE_EOF'
user-db:user
system-db:local
PROFILE_EOF

echo "I: Profile written: ${DCONF_PROFILE}"

# =============================================================================
# PART 2: Install the live-config dconf compile hook
# =============================================================================

echo "P: 98-mse_dconf_compile.chroot | installing live-config dconf compile hook."

if [ ! -d "${LIVE_CONFIG_DIR}" ]; then
    mkdir -p "${LIVE_CONFIG_DIR}"
fi

cat > "${DCONF_HOOK}" << 'HOOK_EOF'
#!/bin/sh
# 0500-mse-dconf — live-config hook
# Compiles all MSE dconf databases at boot, after live-config has completed
# its own GNOME initialisation. Installed by: 98-mse_dconf_compile.chroot

STAMP="/var/lib/live/config/0500-mse-dconf"
[ -e "${STAMP}" ] && exit 0

echo "MSE: compiling dconf database."
dconf update
echo "MSE: dconf compiled."

mkdir -p /var/lib/live/config
touch "${STAMP}"
HOOK_EOF

chmod 755 "${DCONF_HOOK}"
echo "I: live-config hook installed: ${DCONF_HOOK}"
echo "P: 98-mse_dconf_compile.chroot | complete."
