#!/bin/sh
# config/hooks/normal/99-mse_disable-gnome-tour.hook.chroot
# Disables the GNOME welcome tour / initial setup for all users

set -e

# 1. Remove the tour and initial-setup packages if present
apt-get purge --yes gnome-tour gnome-initial-setup || true
apt-get autoremove --yes --purge || true

# 2. Belt-and-braces: mark initial setup as done for new users via /etc/skel
mkdir -p /etc/skel/.config
echo yes > /etc/skel/.config/gnome-initial-setup-done

# 3. Mask the autostart entries in case the packages get pulled back in
mkdir -p /etc/xdg/autostart
for f in org.gnome.Tour.desktop gnome-initial-setup-first-login.desktop; do
    cat > "/etc/xdg/autostart/$f" <<EOF
[Desktop Entry]
Type=Application
Name=Disabled
Exec=/bin/true
Hidden=true
NoDisplay=true
X-GNOME-Autostart-enabled=false
EOF
done

# 4. Set the dconf default so the shell never shows the welcome dialog
mkdir -p /etc/dconf/db/local.d /etc/dconf/profile

[ -f /etc/dconf/profile/user ] || cat > /etc/dconf/profile/user <<EOF
user-db:user
system-db:local
EOF

cat > /etc/dconf/db/local.d/00-no-welcome <<EOF
[org/gnome/shell]
welcome-dialog-last-shown-version='999'
EOF

dconf update
