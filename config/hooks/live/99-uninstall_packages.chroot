#!/bin/sh
# 99-uninstall_packages.chroot
#                                                                                                                             
# SPDX-License-Identifier: GPL-3.0-or-later                                                                                   
# SPDX-FileCopyrightText: 2026 Andreas HABEGGER <andreas.habegger@proton.me> 
#
# MUST RUN LAST — high numeric prefix enforces this.
#
# Removes packages that were needed during the build by other hooks but are
# not wanted in the final live image, and purges unwanted recommends.
#
# Depends on (must run after):
#   88-mse_setup_users   (uses whois/mkpasswd)
#   91-mse_download_template (uses curl)
#   93-mse_branding      (uses imagemagick, librsvg2-bin, curl)

set -e

# =============================================================================
# Helper: purge only the packages from the argument list that are actually
# installed. Absent packages are silently skipped, so a missing package never
# aborts the purge of the others. Does nothing if none are installed.
# =============================================================================

purge_if_installed() {
    to_purge=$(dpkg-query -W -f='${Package} ${db:Status-Status}\n' "$@" 2>/dev/null \
        | awk '$2 == "installed" { print $1 }')
    if [ -n "$to_purge" ]; then
        # shellcheck disable=SC2086
        apt-get purge -y $to_purge
    fi
}

# =============================================================================
# Packages pulled in as recommends — not wanted in exam environment
# =============================================================================

echo "P: 99-uninstall_packages.chroot -- Clean-up system and purge unwanted packages."

# Note: DON'T purge xscreensaver — without it screensavers in MATE/LXDE/XFCE
# crash (observed in Debian 9; kept as precaution).

echo "I:     Purging unwanted recommends."

purge_if_installed \
    firmware-marvell-prestera \
    gnome-contacts \
    gnome-maps \
    gnome-weather \
    hunspell-de-de \
    hunspell-es \
    hunspell-fr-classical \
    hunspell-pt-br \
    hunspell-ru \
    malcontent-gui \
    myspell-fa \
    myspell-sq \
    sane-utils \
    totem \
    totem-plugins \
    xserver-xorg-video-intel \
    zutty

# NOTE: hunspell-fr, hunspell-it, hunspell-en-us and hunspell-en-gb are
# intentionally kept — needed for LibreOffice spellcheck in the exam
# environment (de_CH, fr_CH, it_CH, en_GB, en_US locales).

# =============================================================================
# AppArmor — prevents evince from starting
# =============================================================================

echo "I:     Purging apparmor."

purge_if_installed apparmor

# =============================================================================
# DHCP client — isc-dhcp-client has a known bug (Debian 9); may not be
# present in Trixie
# =============================================================================

echo "I:     Purging isc-dhcp-client."

purge_if_installed \
    isc-dhcp-client \
    isc-dhcp-common

# =============================================================================
# Bluetooth — disabled in exam environment to prevent data exchange
# =============================================================================

echo "I:     Purging bluetooth packages."

purge_if_installed \
    bluez \
    bluez-obexd \
    gnome-bluetooth \
    pulseaudio-module-bluetooth

# =============================================================================
# GNOME Software — triggers password prompt at startup in exam environment
# =============================================================================

echo "I:     Purging gnome-software."

purge_if_installed gnome-software

# =============================================================================
# Build-time tools — used by hooks, not needed in the live image
#   whois         → mkpasswd now runs on host (not in chroot)
#   imagemagick   → 93-mse_wallpaper, 94-mse_bootlogo (wallpaper/GRUB generation)
#   librsvg2-bin  → 93-mse_wallpaper, 94-mse_bootlogo (SVG to PNG conversion)
# =============================================================================

echo "I:     Purging build-time tools."

# NOTE: curl is intentionally NOT purged here.
# It is needed at runtime by /usr/local/bin/fetch-template.sh
# which downloads the MSE exam template at every student login.

# NOTE: whois is no longer installed in the chroot — mkpasswd now
# runs on the build host in functions.sh. Nothing to purge here.

purge_if_installed \
    imagemagick \
    librsvg2-bin

# =============================================================================
# Optional utilities — present only with certain build settings
# =============================================================================

echo "I:     Purging not needed utils."

purge_if_installed \
    jbackpack \
    jbackpack-restore \
    jbackpack-restore-admin \
    wxmaxima \
    gnome-calendar \
    projecteur \
    gnome-connections \
    lernstick-flatpak-musescore \
    timidity \
    pspp \
    lernstick-onboard \
    onboard \
    gnome-snapshot \
    lernstick-libreoffice-impress \
    libreoffice-impress \
    lernstick-libreoffice-draw \
    libreoffice-draw \
    virtualbox \
    rsync \
    sshfs \
    openssh-client \
    openssh-server \
    openssh-sftp-server

# =============================================================================
# Final cleanup
# =============================================================================

apt-get autoremove -y --purge
apt-get clean
rm -rf /var/lib/apt/lists/*

echo "P: 99-uninstall_packages.chroot -- Uninstall complete."
