#!/bin/bash
# 9000-firefox-kiosk-permissions.hook.chroot
# Sets executable permissions on Firefox kiosk wrapper scripts
# and marks the desktop launchers as trusted/executable.
# Runs inside the chroot during lb build.

set -e

echo "Setting permissions on Firefox kiosk wrapper scripts..."

chmod 755 /usr/local/bin/firefox-upload.sh
chmod 755 /usr/local/bin/firefox-moodle.sh

echo "Marking desktop launchers as executable in skel..."

chmod 755 /etc/skel/Desktop/fileUpload.desktop
chmod 755 /etc/skel/Desktop/moodle.desktop

echo "Done."
