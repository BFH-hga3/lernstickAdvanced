#!/bin/sh
set -e

TEMPLATE_LOCAL="/usr/local/share/templates/mse-default.ott"
SCRIPT="/usr/local/bin/fetch-template.sh"

# Ensure template directory exists (system path, no user needed)
mkdir -p /usr/local/share/templates

# Verify fallback template is present
if [ -f "${TEMPLATE_LOCAL}" ]; then
    echo "Template already present"
else
    echo "WARNING: No fallback template found at ${TEMPLATE_LOCAL}!"
fi

# Create the fetch script (runs at login in the live session where 'user' exists)
cat > "${SCRIPT}" << 'EOF'
#!/bin/sh

USER="user"
DESKTOP="/home/$USER/Desktop"
TARGET="$DESKTOP/MSE_FullName_ModuleCode.ott"
TEMPLATE_LOCAL="/usr/local/share/templates/mse-default.ott"
NEXTCLOUD_URL="https://drive.switch.ch/index.php/s/tQLKBilUJ7l8DLj/download"

# Ensure Desktop exists (user is now live, so this is safe)
mkdir -p "$DESKTOP"

# Wait for network (up to 10 seconds)
if command -v nm-online >/dev/null 2>&1; then
    nm-online -q --timeout=10
fi

# Try to download template
if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$NEXTCLOUD_URL" -o "$TARGET"
    STATUS=$?
elif command -v wget >/dev/null 2>&1; then
    wget -q "$NEXTCLOUD_URL" -O "$TARGET"
    STATUS=$?
else
    STATUS=1
fi

# Fallback if download failed or file is empty
if [ "$STATUS" -ne 0 ] || [ ! -s "$TARGET" ]; then
    cp "$TEMPLATE_LOCAL" "$TARGET"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Template fallback" "Using local template (SwitchDrive unavailable)"
    else
        echo "Using local template (SwitchDrive unavailable)"
    fi
else
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Template loaded" "Downloaded from SwitchDrive"
    fi
fi

# Fix ownership (user now exists in live session)
chown "$USER:$USER" "$TARGET"
EOF

chmod +x "${SCRIPT}"

# Create XDG autostart entry so the script runs at login
mkdir -p /etc/xdg/autostart

cat > /etc/xdg/autostart/fetch-template.desktop << EOF
[Desktop Entry]
Type=Application
Name=Fetch MSE Template
Exec=${SCRIPT}
X-GNOME-Autostart-enabled=true
EOF

