#!/bin/sh
set -e

# Username to modify
USER="user"

# Pre-generated password hash (example: "***MASKED***")
HASH='$6$kG9DCXo0oJTrAC5r$FY/yFXsYN9SFgKn1fM6hsprAZcTNaTQwQ0YbZAwIU38u9pdThjL2XOVI1S2Trm1tCUBzjgLj4bvtmNybJBDhc0'

# Ensure user exists
if id "$USER" >/dev/null 2>&1; then
    echo "Setting password hash for $USER"
    usermod -p "$HASH" "$USER"
else
    echo "User $USER does not exist"
fi
