#!/bin/sh
# setup_users.hook.chroot
#
# Uses live-config's own infrastructure to:
#   1. Set passwords for "user" and "sysadmin" via a live-config passwd hook
#   2. Create "sysadmin" via a live-config useradd hook
#   3. Grant sysadmin sudo via /etc/sudoers.d/mse-exam (baked at build time)
#   4. Disable live-config's 0040-sudo component (prevents NOPASSWD for user)
#
# Passwords are read from environment variables set in the `constants` file
# (which is gitignored). If the variables are absent, default values are used.
# Passwords are hashed at build time with yescrypt — no cleartext in the image.

set -e

# =============================================================================
# CONFIGURATION — edit here only
# =============================================================================

LIVE_USER="user"
ADMIN_USER="sysadmin"
ADMIN_USER_GECOS="System Administrator"
ADMIN_USER_SHELL="/bin/bash"

# Passwords: read from environment (set in constants) or fall back to defaults.
# Set these in your constants file (gitignored):
#   export MSE_USER_PASSWORD="your-secret"
#   export MSE_ADMIN_PASSWORD="your-secret"
LIVE_USER_PASSWORD="${MSE_USER_PASSWORD:-live}"
ADMIN_USER_PASSWORD="${MSE_ADMIN_PASSWORD:-sysadmin}"

# live-config hook directory
LIVE_CONFIG_DIR="/lib/live/config"

# Sudoers file
SUDOERS_FILE="/etc/sudoers.d/mse-exam"

# live-config component disable config
LIVE_CONF_DIR="/etc/live/config.conf.d"
LIVE_CONF_FILE="${LIVE_CONF_DIR}/mse-exam.conf"

# =============================================================================
# DERIVED PATHS — do not edit
# =============================================================================

PASSWD_HOOK="${LIVE_CONFIG_DIR}/2000-mse-passwd"
ADDUSER_HOOK="${LIVE_CONFIG_DIR}/1000-mse-adduser"

# =============================================================================
# PART 1: Hash passwords at build time
# =============================================================================

echo "==> [1/4] Hashing passwords at build time (yescrypt)..."

if ! command -v mkpasswd >/dev/null 2>&1; then
    echo "ERROR: mkpasswd not found. Add 'whois' to your package lists."
    exit 1
fi

# Report whether passwords came from environment or defaults
if [ -n "${MSE_USER_PASSWORD}" ]; then
    echo "    '${LIVE_USER}': using password from MSE_USER_PASSWORD."
else
    echo "    '${LIVE_USER}': MSE_USER_PASSWORD not set — using default."
fi

if [ -n "${MSE_ADMIN_PASSWORD}" ]; then
    echo "    '${ADMIN_USER}': using password from MSE_ADMIN_PASSWORD."
else
    echo "    '${ADMIN_USER}': MSE_ADMIN_PASSWORD not set — using default."
fi

LIVE_USER_HASH=$(mkpasswd --method=yescrypt "${LIVE_USER_PASSWORD}")
ADMIN_USER_HASH=$(mkpasswd --method=yescrypt "${ADMIN_USER_PASSWORD}")

echo "    Hashed '${LIVE_USER}'."
echo "    Hashed '${ADMIN_USER}'."

# =============================================================================
# PART 2: Install live-config adduser hook (runs at 1000, before passwd at 2000)
# Creates sysadmin after user-setup (0030) has finished.
# =============================================================================

echo "==> [2/4] Installing live-config adduser hook (${ADDUSER_HOOK})..."

mkdir -p "${LIVE_CONFIG_DIR}"

cat > "${ADDUSER_HOOK}" << EOF
#!/bin/sh
# 1000-mse-adduser — live-config hook
# Creates the sysadmin account as part of the live-config boot sequence.
# Runs after 0030-user-setup, before 2000-mse-passwd.

STAMP="/var/lib/live/config/1000-mse-adduser"
[ -e "\${STAMP}" ] && exit 0

ADMIN_USER="${ADMIN_USER}"
ADMIN_USER_GECOS="${ADMIN_USER_GECOS}"
ADMIN_USER_SHELL="${ADMIN_USER_SHELL}"

if ! id "\${ADMIN_USER}" >/dev/null 2>&1; then
    useradd \\
        --create-home \\
        --shell "\${ADMIN_USER_SHELL}" \\
        --comment "\${ADMIN_USER_GECOS}" \\
        --groups sudo \\
        "\${ADMIN_USER}"
    echo "MSE: created '\${ADMIN_USER}'."
else
    usermod -aG sudo "\${ADMIN_USER}"
    echo "MSE: '\${ADMIN_USER}' already exists — ensured sudo membership."
fi

mkdir -p /var/lib/live/config
touch "\${STAMP}"
EOF

chmod 755 "${ADDUSER_HOOK}"
echo "    Installed: ${ADDUSER_HOOK}"

# =============================================================================
# PART 3: Install live-config passwd hook (runs at 2000)
# Sets hashed passwords for both users after they exist.
# =============================================================================

echo "==> [3/4] Installing live-config passwd hook (${PASSWD_HOOK})..."

cat > "${PASSWD_HOOK}" << EOF
#!/bin/sh
# 2000-mse-passwd — live-config hook
# Sets yescrypt-hashed passwords for live user and sysadmin.
# Also removes live user from sudo group and cleans up 0040-sudo artefacts.
# Passwords were hashed at build time — no cleartext in this file.

STAMP="/var/lib/live/config/2000-mse-passwd"
[ -e "\${STAMP}" ] && exit 0

LIVE_USER="${LIVE_USER}"
LIVE_USER_HASH="${LIVE_USER_HASH}"

ADMIN_USER="${ADMIN_USER}"
ADMIN_USER_HASH="${ADMIN_USER_HASH}"

echo "MSE: setting passwords..."

# Set password for live user
if id "\${LIVE_USER}" >/dev/null 2>&1; then
    usermod --password "\${LIVE_USER_HASH}" "\${LIVE_USER}"
    echo "  Password set for '\${LIVE_USER}'."
else
    echo "  WARNING: '\${LIVE_USER}' not found."
fi

# Set password for sysadmin
if id "\${ADMIN_USER}" >/dev/null 2>&1; then
    usermod --password "\${ADMIN_USER_HASH}" "\${ADMIN_USER}"
    echo "  Password set for '\${ADMIN_USER}'."
else
    echo "  WARNING: '\${ADMIN_USER}' not found."
fi

# Remove live user from sudo group (exam safety)
if groups "\${LIVE_USER}" 2>/dev/null | grep -q sudo; then
    gpasswd -d "\${LIVE_USER}" sudo 2>/dev/null || true
    echo "  Removed '\${LIVE_USER}' from sudo group."
fi

# Remove /etc/sudoers.d/live written by 0040-sudo if it slipped through
if [ -f /etc/sudoers.d/live ]; then
    rm -f /etc/sudoers.d/live
    echo "  Removed /etc/sudoers.d/live."
fi

echo "  Groups: \${LIVE_USER}=\$(groups \${LIVE_USER} 2>/dev/null)"
echo "  Groups: \${ADMIN_USER}=\$(groups \${ADMIN_USER} 2>/dev/null)"
echo "MSE: password setup complete."

mkdir -p /var/lib/live/config
touch "\${STAMP}"
EOF

chmod 755 "${PASSWD_HOOK}"
echo "    Installed: ${PASSWD_HOOK}"

# =============================================================================
# PART 4: Sudoers policy + disable 0040-sudo component
# =============================================================================

echo "==> [4/4] Installing sudoers policy and disabling 0040-sudo..."

mkdir -p /etc/sudoers.d

cat > "${SUDOERS_FILE}" << EOF
# MSE Exam sudoers policy
# Generated by: setup_users.hook.chroot

# sysadmin: full sudo with password
${ADMIN_USER} ALL=(ALL) PASSWD: ALL

# user: explicitly denied all sudo commands
${LIVE_USER} ALL=(ALL) !ALL
EOF

chmod 0440 "${SUDOERS_FILE}"
chown root:root "${SUDOERS_FILE}"
visudo -c -f "${SUDOERS_FILE}"
echo "    Sudoers policy validated: ${SUDOERS_FILE}"

mkdir -p "${LIVE_CONF_DIR}"

cat > "${LIVE_CONF_FILE}" << EOF
# MSE Exam live-config overrides
# Disables 0040-sudo which grants live user NOPASSWD sudo access.
# Sudo policy is managed via ${SUDOERS_FILE} instead.
LIVE_CONFIG_NOCOMPONENTS="sudo"
EOF

echo "    0040-sudo disabled via: ${LIVE_CONF_FILE}"
echo "==> setup_users hook complete."
