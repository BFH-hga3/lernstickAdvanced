#!/bin/sh

# Note: DON'T purge xscreensaver, without it the screensavers in MATE, LXDE and XFCE just crash (seen in Debian 9)

# Building the system with recommends enabled pulls in a lot of packages we
# don't want to have. Unfortunately, we have no blacklist while building the
# system so we have to remove them here right after installing them...
apt-get purge -y \
	firmware-marvell-prestera \
	gnome-contacts \
	gnome-maps \
	gnome-weather \
	hunspell-de-de \
	hunspell-es \
	hunspell-fr-classical \
	hunspell-pt-br \
	hunspell-ru \
	malcontent-gui \
	myspell-fa \
	myspell-sq \
	sane-utils \
	totem \
	totem-plugins \
	xserver-xorg-video-intel \
	zutty

# NOTE: hunspell-fr, hunspell-it, hunspell-en-us and hunspell-en-gb intentionally kept
# as they are needed for LibreOffice spellcheck in the exam environment
# (de_CH, fr_CH, it_CH, en_GB, en_US locales).

# for whatever reason apparmor prevents evince from starting
# therefore we remove it here
apt-get purge -y \
	apparmor

# The default DHCP client in Debian 9 (isc-dhcp-client) has a horrible bug.
# Therefore it is better to remove this package.
apt-get purge -y \
	isc-dhcp-client \
	isc-dhcp-common

# In the exam environment we have to disable bluetooth support to prevent
# data exchange with smartphones, etc.
apt-get purge -y \
	bluez \
	bluez-obexd \
	gnome-bluetooth \
	pulseaudio-module-bluetooth

# we don't want to have gnome-software in the exam environment
# because it triggers a password prompt at every startup
apt-get purge -y \
	gnome-software

# Remove packages used by mse_setup_users.hook.chroot
#
apt-get purge -y \
	whois

# Remove packages used by mse_branding.hook.chroot
#
apt-get purge -y \
        imagemagick \
        librsvg2-bin

# clean up
apt-get purge -y --auto-remove

